<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_epc_site_survey_user" model="ir.rule">
            <field name="name">Site Survey: field users see their own</field>
            <field name="model_id" ref="model_epc_site_survey"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('engineer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_user'))]"/>
        </record>
        <record id="rule_epc_site_survey_manager" model="ir.rule">
            <field name="name">Site Survey: managers see all</field>
            <field name="model_id" ref="model_epc_site_survey"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_manager'))]"/>
        </record>
    </data>
</odoo>
