<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_order_milestone_view_list" model="ir.ui.view">
            <field name="name">epc.order.milestone.list</field>
            <field name="model">epc.order.milestone</field>
            <field name="arch" type="xml">
                <list string="Milestone Billing" create="0">
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <field name="name"/>
                    <field name="percentage"/>
                    <field name="amount" sum="Total"/>
                    <field name="trigger"/>
                    <field name="due_date"/>
                    <field name="invoice_id"/>
                    <field name="payment_state" widget="badge" optional="show"/>
                    <field name="state" widget="badge" decoration-success="state == 'invoiced'" decoration-warning="state == 'scheduled'"/>
                    <field name="currency_id" column_invisible="1"/>
                    <button name="action_raise_invoice" type="object" string="Raise Invoice" icon="fa-file-text-o"
                            invisible="state == 'invoiced'"/>
                </list>
            </field>
        </record>
        <record id="epc_order_milestone_view_search" model="ir.ui.view">
            <field name="name">epc.order.milestone.search</field>
            <field name="model">epc.order.milestone</field>
            <field name="arch" type="xml">
                <search>
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <filter name="not_invoiced" string="Not Invoiced Yet" domain="[('state', '!=', 'invoiced')]"/>
                    <group expand="0" string="Group By">
                        <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="g_trigger" string="Stage" context="{'group_by': 'trigger'}"/>
                        <filter name="g_order" string="Order" context="{'group_by': 'order_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="epc_order_milestone_view_pivot" model="ir.ui.view">
            <field name="name">epc.order.milestone.pivot</field>
            <field name="model">epc.order.milestone</field>
            <field name="arch" type="xml">
                <pivot string="Milestone Billing">
                    <field name="trigger" type="row"/>
                    <field name="state" type="col"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>
        <record id="epc_order_milestone_action" model="ir.actions.act_window">
            <field name="name">Milestone Billing</field>
            <field name="res_model">epc.order.milestone</field>
            <field name="view_mode">list,pivot</field>
            <field name="context">{'search_default_not_invoiced': 1}</field>
        </record>
    </data>
</odoo>
