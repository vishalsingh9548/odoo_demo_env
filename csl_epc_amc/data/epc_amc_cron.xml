<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily: expire finished AMC contracts, send "ending soon" reminders and
             (if switched on) create the preventive service visits that are due -->
        <record id="ir_cron_epc_amc_maintenance" model="ir.cron">
            <field name="name">Solar AMC: daily maintenance</field>
            <field name="model_id" ref="model_epc_amc_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_epc_amc_maintenance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
