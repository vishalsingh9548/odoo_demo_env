<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_epc_commissioning_user" model="ir.rule">
            <field name="name">Commissioning: field users see their own</field>
            <field name="model_id" ref="model_epc_commissioning"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_user'))]"/>
        </record>
        <record id="rule_epc_commissioning_manager" model="ir.rule">
            <field name="name">Commissioning: managers see all</field>
            <field name="model_id" ref="model_epc_commissioning"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_manager'))]"/>
        </record>
        <record id="rule_epc_commissioning_punch_user" model="ir.rule">
            <field name="name">Punch item: field users see their own</field>
            <field name="model_id" ref="model_epc_commissioning_punch"/>
            <field name="domain_force">[('commissioning_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_user'))]"/>
        </record>
        <record id="rule_epc_commissioning_punch_manager" model="ir.rule">
            <field name="name">Punch item: managers see all</field>
            <field name="model_id" ref="model_epc_commissioning_punch"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_manager'))]"/>
        </record>
    </data>
</odoo>
