<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="project_view_form_epc_commissioning" model="ir.ui.view">
            <field name="name">project.view.form.epc.commissioning</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="csl_epc_core.project_view_form_epc"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_open_share_project_wizard']" position="after">
                    <button name="action_create_commissioning" string="Proceed to Commissioning" type="object"
                            class="oe_highlight" invisible="not epc_all_tasks_done or commissioning_count != 0"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
