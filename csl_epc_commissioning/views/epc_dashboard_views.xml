<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Live dashboard of this stage, rendered by the generic screen in csl_epc_core.
             It is the first menu entry, so the app opens on it. -->
        <record id="epc_dashboard_commissioning_action" model="ir.actions.client">
            <field name="name">Commissioning Dashboard</field>
            <field name="tag">epc_stage_dashboard</field>
            <field name="target">current</field>
            <field name="params" eval="{'stage': 'commissioning'}"/>
        </record>
        <menuitem id="menu_epc_dashboard_commissioning"
                  name="Dashboard"
                  parent="menu_epc_commissioning"
                  action="epc_dashboard_commissioning_action"
                  sequence="1"/>

        <!-- Drill-down list opened from the dashboard (punch items) -->
        <record id="epc_commissioning_punch_view_list" model="ir.ui.view">
            <field name="name">epc.commissioning.punch.list</field>
            <field name="model">epc.commissioning.punch</field>
            <field name="arch" type="xml">
                <list create="0" delete="0" decoration-muted="done">
                    <field name="commissioning_id"/>
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="done"/>
                    <field name="remarks" optional="show"/>
                    <field name="create_date" string="Logged On"/>
                </list>
            </field>
        </record>
        <record id="epc_commissioning_punch_view_form" model="ir.ui.view">
            <field name="name">epc.commissioning.punch.form</field>
            <field name="model">epc.commissioning.punch</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="commissioning_id"/>
                            <field name="name"/>
                            <field name="owner_id"/>
                            <field name="done"/>
                            <field name="remarks"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="epc_commissioning_punch_view_search" model="ir.ui.view">
            <field name="name">epc.commissioning.punch.search</field>
            <field name="model">epc.commissioning.punch</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="commissioning_id"/>
                    <field name="owner_id"/>
                    <filter name="open" string="Open" domain="[('done', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                        <filter name="group_commissioning" string="Commissioning" context="{'group_by': 'commissioning_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
