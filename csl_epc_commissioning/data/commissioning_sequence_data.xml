<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Gives every Commissioning record a reference like COM/2026/00001 -->
        <record id="seq_epc_commissioning" model="ir.sequence">
            <field name="name">Commissioning Sequence</field>
            <field name="code">epc.commissioning</field>
            <field name="prefix">COM/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
