<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_reject_wizard_view_form" model="ir.ui.view">
            <field name="name">epc.reject.wizard.form</field>
            <field name="model">epc.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject">
                    <group>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="reason" placeholder="What needs to be corrected?"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Reject" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
