<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_net_meter_view_list" model="ir.ui.view">
            <field name="name">epc.net.meter.list</field>
            <field name="model">epc.net.meter</field>
            <field name="arch" type="xml">
                <list string="Net Metering">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="discom_id"/>
                    <field name="application_number"/>
                    <field name="applied_date"/>
                    <field name="stuck_days"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'synced'" decoration-danger="state == 'rejected'"
                           decoration-info="state in ('applied', 'discom_approved', 'inspection_done', 'meter_installed')"/>
                </list>
            </field>
        </record>
        <record id="epc_net_meter_view_form" model="ir.ui.view">
            <field name="name">epc.net.meter.form</field>
            <field name="model">epc.net.meter</field>
            <field name="arch" type="xml">
                <form string="Net Metering">
                    <header>
                        <button name="action_apply" string="Mark Applied" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" string="DISCOM Approved" type="object" class="oe_highlight" invisible="state != 'applied'"/>
                        <button name="action_inspection_done" string="Inspection Done" type="object" class="oe_highlight" invisible="state != 'discom_approved'"/>
                        <button name="action_meter_installed" string="Meter Installed" type="object" class="oe_highlight" invisible="state != 'inspection_done'"/>
                        <button name="action_sync" string="Mark Synced" type="object" class="oe_highlight" invisible="state != 'meter_installed'"/>
                        <button name="action_reject" string="Rejected" type="object" invisible="state in ('draft', 'synced', 'rejected')"/>
                        <button name="action_reset" string="Reset to Draft" type="object" invisible="state in ('draft', 'synced')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,applied,discom_approved,inspection_done,meter_installed,synced"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                        <group>
                            <group string="Connection">
                                <field name="project_id"/>
                                <field name="partner_id"/>
                                <field name="discom_id"/>
                                <field name="consumer_number"/>
                                <field name="application_number"/>
                                <field name="meter_number"/>
                            </group>
                            <group string="Dates">
                                <field name="applied_date"/>
                                <field name="approval_date"/>
                                <field name="inspection_date"/>
                                <field name="meter_installed_date"/>
                                <field name="sync_date"/>
                                <field name="stuck_days"/>
                            </group>
                        </group>
                        <group string="Remarks"><field name="remarks" nolabel="1"/></group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="epc_net_meter_view_search" model="ir.ui.view">
            <field name="name">epc.net.meter.search</field>
            <field name="model">epc.net.meter</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="application_number"/>
                    <filter name="open" string="Not Synced Yet" domain="[('state', 'not in', ('synced', 'rejected'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="g_discom" string="DISCOM" context="{'group_by': 'discom_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="epc_net_meter_action" model="ir.actions.act_window">
            <field name="name">Net Metering</field>
            <field name="res_model">epc.net.meter</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_open': 1}</field>
        </record>
    </data>
</odoo>
