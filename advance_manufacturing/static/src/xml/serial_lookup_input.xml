<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advance_manufacturing.SerialLookupInput">
        <div class="advmfg_input_wrap">
            <i t-att-class="iconClass + ' advmfg_icon'"/>
            <input type="text" class="o_input o_field_char" placeholder="Scan or type the serial number" autofocus="autofocus"
                   t-on-change="onSerialChange"/>
            <span class="advmfg_enter">Enter ↵</span>
        </div>
    </t>
</templates>
