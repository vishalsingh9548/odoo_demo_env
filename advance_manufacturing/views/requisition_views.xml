<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Approver master ===== -->
    <record id="view_mr_approver_master_form" model="ir.ui.view">
        <field name="name">material.request.approver.master.form</field>
        <field name="model">material.request.approver.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="material_type"/><field name="approvals_type" invisible="1"/><field name="no_of_approvals"/></group>
                        <group><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <field name="approver_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="approver_level"/>
                            <field name="approver_id" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mr_approver_master_list" model="ir.ui.view">
        <field name="name">material.request.approver.master.list</field>
        <field name="model">material.request.approver.master</field>
        <field name="arch" type="xml"><list><field name="material_type"/><field name="no_of_approvals"/><field name="company_id" groups="base.group_multi_company"/></list></field>
    </record>
    <record id="action_mr_approver_master" model="ir.actions.act_window">
        <field name="name">Material Request Approvers</field>
        <field name="res_model">material.request.approver.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== Requisition ===== -->
    <record id="view_material_requisition_form" model="ir.ui.view">
        <field name="name">material.requisition.form</field>
        <field name="model">material.requisition</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_manager_admin" invisible="1"/>
                <field name="has_unavailable_products" invisible="1"/>
                <field name="is_purchase_order_creation_blocked_for_user" invisible="1"/>
                <field name="no_of_approvals" invisible="1"/>
                <field name="mrp_production_id" invisible="1"/>
                <header>
                    <button name="action_request_approval" type="object" string="Request Approval" class="btn-primary"
                            invisible="state not in ('draft', 'rejected', 'cancelled')"/>
                    <button name="action_create_purchase_order" type="object" string="Create Purchase Order"
                            invisible="state not in ('draft', 'waiting_for_approval') or is_purchase_order_creation_blocked_for_user"/>
                    <button name="action_recommend_and_forward" type="object" string="Recommend &amp; Forward" class="btn-primary"
                            invisible="state != 'waiting_for_approval'"/>
                    <button name="action_approve_level" type="object" string="Approve" class="btn-success"
                            invisible="state != 'second_approval'"/>
                    <button name="action_received" type="object" string="Received" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="state in ('rejected', 'cancelled', 'received')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('rejected', 'cancelled', 'received')"/>
                    <button name="action_set_to_draft" type="object" string="Set to Draft" invisible="state in ('draft', 'received')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Received" bg_color="text-bg-primary" invisible="state != 'received'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                        <button name="action_view_transfer" type="object" class="oe_stat_button" icon="fa-truck" invisible="transfer_count == 0">
                            <field name="transfer_count" widget="statinfo" string="Internal Transfer"/>
                        </button>
                        <button name="action_view_mrp_production" type="object" class="oe_stat_button" icon="fa-industry" invisible="mrp_production_count == 0">
                            <field name="mrp_production_count" widget="statinfo" string="Manufacturing Order"/>
                        </button>
                        <button name="action_print_requisition_report" type="object" class="oe_stat_button" icon="fa-print" string="Print Report"/>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="request_raised_by" invisible="1"/>
                            <field name="department_id"/>
                            <field name="job_position_id"/>
                            <field name="request_raised_for"/>
                            <field name="product_tmpl_id" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="destination_location_id" readonly="state != 'draft'"/>
                            <field name="indented_date"/>
                            <field name="required_date" readonly="state != 'draft'"/>
                            <field name="verified_date" invisible="not verified_date"/>
                            <field name="requirement" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Products" name="products">
                            <field name="material_requisition_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="onhand_quantity"/>
                                    <field name="is_stock_available"/>
                                    <field name="qty_to_purchase"/>
                                    <field name="selected_lot_ids" widget="many2many_tags" readonly="1" optional="show"/>
                                    <field name="short_close" optional="hide"/>
                                </list>
                            </field>
                            <field name="signature" widget="signature" readonly="state != 'draft'"/>
                        </page>
                        <page string="Approval" name="approval">
                            <group>
                                <field name="approval_type_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="approver_1_id" widget="many2many_tags"/>
                                <field name="current_approver_level"/>
                                <field name="current_approver_user_id"/>
                                <field name="approved_by_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Others" name="others">
                            <group><field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                                <field name="picking_id"/></group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_material_requisition_list" model="ir.ui.view">
        <field name="name">material.requisition.list</field>
        <field name="model">material.requisition</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state in ('approved', 'received')"
                  decoration-warning="state in ('waiting_for_approval', 'second_approval')" decoration-danger="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="request_raised_by"/>
                <field name="request_raised_for"/>
                <field name="required_date"/>
                <field name="verified_date"/>
                <field name="ribbon_status" widget="badge" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_material_requisition_search" model="ir.ui.view">
        <field name="name">material.requisition.search</field>
        <field name="model">material.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="request_raised_by"/><field name="request_raised_for"/><field name="purpose"/>
                <field name="picking_id"/><field name="approval_type_id"/><field name="current_approver_user_id"/>
                <filter name="mine" string="My Requisitions" domain="[('request_raised_by.user_id', '=', uid)]"/>
                <filter name="pending_mine" string="Pending My Approval"
                        domain="[('state', 'in', ('waiting_for_approval', 'second_approval')), ('current_approver_user_id', '=', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By"><filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_by" string="Requested By" context="{'group_by': 'request_raised_by'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_material_requisition" model="ir.actions.act_window">
        <field name="name">Material Requisitions</field>
        <field name="res_model">material.requisition</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_material_requisition_root" name="Material Requisition" web_icon="advance_manufacturing,static/description/icon_requisition.png"
              groups="advance_manufacturing.group_advmfg_manager" sequence="86"/>
    <menuitem id="menu_material_requisition" name="Requisitions" parent="menu_material_requisition_root"
              action="action_material_requisition" sequence="1"/>
    <menuitem id="menu_material_requisition_config" name="Configuration" parent="menu_material_requisition_root" sequence="99"/>
    <menuitem id="menu_mr_approver_master" name="Material Request Approvers" parent="menu_material_requisition_config"
              action="action_mr_approver_master" sequence="1" groups="base.group_system"/>
    <record id="view_material_requisition_excel_wizard_form" model="ir.ui.view">
        <field name="name">material.requisition.excel.wizard.form</field>
        <field name="model">material.requisition.excel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group><group><field name="start_date"/><field name="end_date"/></group>
                    <group><field name="request_raised_by" widget="many2many_tags"/><field name="request_raised_for" widget="many2many_tags"/></group></group>
                <footer><button name="action_download" type="object" string="Download Excel" class="btn-primary"/>
                    <button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="action_material_requisition_excel" model="ir.actions.act_window">
        <field name="name">Purchase Requisition Excel Report</field>
        <field name="res_model">material.requisition.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_mr_excel" name="Purchase Requisition Excel Report" parent="menu_material_requisition_config"
              action="action_material_requisition_excel" sequence="10"/>

    <!-- Lot picker -->
    <record id="view_mr_lot_wizard_form" model="ir.ui.view">
        <field name="name">material.requisition.lot.wizard.form</field>
        <field name="model">material.requisition.lot.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">Choose the lots the store should send for each product below, then confirm.</div>
                <field name="requisition_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id"/>
                        <field name="required_qty"/>
                        <field name="product_uom"/>
                        <field name="available_lots_info"/>
                        <field name="candidate_lot_ids" column_invisible="1"/>
                        <field name="lot_ids" widget="many2many_tags" domain="[('id', 'in', candidate_lot_ids)]"/>
                        <field name="selected_qty"/>
                    </list>
                </field>
                <footer><button name="action_confirm" type="object" string="Confirm &amp; Forward" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/></footer>
            </form>
        </field>
    </record>

    <!-- Manufacturing order buttons -->
    <record id="view_mrp_production_form_requisition" model="ir.ui.view">
        <field name="name">mrp.production.form.requisition</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="has_low_raw_materials" invisible="1"/>
                <button name="action_create_material_requisition" type="object" string="Material Requisition" class="oe_highlight"
                        groups="advance_manufacturing.group_advmfg_manager" invisible="not has_low_raw_materials"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_material_requisitions" type="object" class="oe_stat_button" icon="fa-list-alt"
                        groups="advance_manufacturing.group_advmfg_manager" invisible="material_requisition_count == 0">
                    <field name="material_requisition_count" widget="statinfo" string="Material Requisition"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Manufacturing order list: newest start date first -->
    <record id="view_mrp_production_tree_order" model="ir.ui.view">
        <field name="name">mrp.production.list.order</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes"><attribute name="default_order">date_start desc, id desc</attribute></xpath>
        </field>
    </record>

    <!-- Location flags -->
    <record id="view_location_form_advmfg" model="ir.ui.view">
        <field name="name">stock.location.form.advmfg</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scrap_location']" position="after">
                <field name="for_scrap_order" invisible="usage != 'internal'"/>
                <field name="is_mo_stock" invisible="usage != 'internal'"/>
                <field name="is_mr_source_location" invisible="usage != 'internal'"/>
            </xpath>
        </field>
    </record>

    <!-- User fields -->
    <record id="view_users_form_requisition" model="ir.ui.view">
        <field name="name">res.users.form.requisition</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advmfg_user_flags']//group" position="inside">
                <group string="Material Requisition Controls">
                    <field name="mr_approval_type_id" options="{'no_create': True}"/>
                    <field name="block_create_purchase_order"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Report -->
    <record id="action_report_material_requisition" model="ir.actions.report">
        <field name="name">Material Requisition Report</field>
        <field name="model">material.requisition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advance_manufacturing.report_material_requisition</field>
        <field name="report_file">advance_manufacturing.report_material_requisition</field>
        <field name="print_report_name">object.name.replace('/', '_')</field>
        <field name="binding_model_id" ref="model_material_requisition"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_material_requisition">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page">
            <h2>Material Requisition <span t-field="o.name"/></h2>
            <table class="table table-sm">
                <tr><td>Requested by</td><td><span t-field="o.request_raised_by.name"/></td><td>Requested for</td><td><span t-field="o.request_raised_for.name"/></td></tr>
                <tr><td>Department</td><td><span t-field="o.department_id.name"/></td><td>Job position</td><td><span t-field="o.job_position_id.name"/></td></tr>
                <tr><td>Reporting manager</td><td><span t-field="o.reporting_manager_id.name"/></td><td>Purpose</td><td><span t-field="o.purpose"/></td></tr>
                <tr><td>Indent date</td><td><span t-field="o.indented_date"/></td><td>Required date</td><td><span t-field="o.required_date"/></td></tr>
                <tr><td>Destination</td><td><span t-field="o.destination_location_id.display_name"/></td><td>Requirement</td><td><span t-field="o.requirement"/></td></tr>
            </table>
            <table class="table table-sm">
                <thead><tr><th>SL.NO</th><th>PRODUCT</th><th>ONHAND QUANTITY</th><th>REQUESTED QTY</th><th>UNIT</th></tr></thead>
                <tbody><t t-foreach="o.material_requisition_line_ids" t-as="l"><tr>
                    <td><t t-esc="l_index + 1"/></td><td><span t-field="l.product_id.display_name"/></td><td><span t-field="l.onhand_quantity"/></td>
                    <td><span t-field="l.product_uom_qty"/></td><td><span t-field="l.product_uom.name"/></td></tr></t></tbody>
            </table>
            <div t-if="o.signature"><p>Signature of the requestor</p><img t-att-src="image_data_uri(o.signature)" style="max-height:80px;"/></div>
        </div></t></t></t>
    </template>
</odoo>
