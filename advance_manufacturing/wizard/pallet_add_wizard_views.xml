<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advmfg_pallet_add_wizard_form" model="ir.ui.view">
        <field name="name">advmfg.pallet.add.wizard.form</field>
        <field name="model">advmfg.pallet.add.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="pallet_id" invisible="1"/>
                <group><field name="serial" placeholder="Scan or type the serial number" autofocus="1"/></group>
                <footer>
                    <button name="action_add" type="object" string="Add" class="btn-primary" data-hotkey="q"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
