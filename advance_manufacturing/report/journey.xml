<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Serial Journey card: one block of light, easy-to-read cards. Used on screen and in the PDF. -->
    <template id="journey_card">
        <div style="background:#EEF3F8;padding:16px;border-radius:12px;font-family:Inter,system-ui,sans-serif;color:#1F2A37;display:flex;flex-direction:column;gap:14px">

            <div style="background:#FFFFFF;border:1px solid #DCE5EE;border-radius:12px;padding:18px 22px">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:10px">
                    <div>
                        <div style="font-size:12px;font-weight:600;color:#5B6776;letter-spacing:.8px;text-transform:uppercase">Serial Journey</div>
                        <div style="font-size:30px;font-weight:700;margin-top:2px"><t t-out="serial"/></div>
                        <div style="font-size:14px;color:#5B6776"><t t-out="product"/></div>
                    </div>
                    <div style="background:#E8F6EF;color:#116A47;border-radius:999px;padding:6px 14px;font-size:12px;font-weight:600">
                        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#178A62;margin-right:6px"></span>Live status · as of <t t-out="now"/>
                    </div>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">
                    <t t-foreach="chips" t-as="c">
                        <span t-attf-style="background:#{c['bg']};color:#{c['fg']};border-radius:999px;padding:5px 12px;font-size:12px;font-weight:600"><t t-out="c['label']"/></span>
                    </t>
                </div>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap">
                <t t-foreach="facts" t-as="f">
                    <div style="flex:1 1 200px;background:#FFFFFF;border:1px solid #DCE5EE;border-radius:12px;padding:14px 16px">
                        <div style="font-size:11px;font-weight:600;color:#5B6776;letter-spacing:.7px;text-transform:uppercase"><t t-out="f['k']"/></div>
                        <div style="font-size:18px;font-weight:700;margin-top:4px"><t t-out="f['v']"/></div>
                        <div style="font-size:12px;color:#5B6776;margin-top:2px"><t t-out="f['s']"/></div>
                    </div>
                </t>
            </div>

            <div style="background:#FFFFFF;border:1px solid #DCE5EE;border-radius:12px;padding:18px 22px">
                <div style="font-size:15px;font-weight:700;margin-bottom:14px">Manufacturing progress</div>
                <div style="display:flex">
                    <t t-foreach="stages" t-as="s">
                        <div style="flex:1 1 0;display:flex;flex-direction:column;align-items:center;gap:6px;position:relative;min-width:0">
                            <div t-attf-style="position:absolute;top:15px;left:0;right:50%;height:3px;background:#{s['left']}"></div>
                            <div t-attf-style="position:absolute;top:15px;left:50%;right:0;height:3px;background:#{s['right']}"></div>
                            <div t-attf-style="position:relative;width:32px;height:32px;border-radius:50%;background:#{s['dot']};color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px"><t t-out="s['mark']"/></div>
                            <div style="font-size:13px;font-weight:600;text-align:center"><t t-out="s['name']"/></div>
                            <div style="font-size:11px;color:#5B6776;text-align:center"><t t-out="s['when']"/></div>
                            <div t-attf-style="font-size:11px;font-weight:600;color:#{s['qc_fg']};background:#{s['qc_bg']};border-radius:999px;padding:2px 9px"><t t-out="s['qc']"/></div>
                        </div>
                    </t>
                </div>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start">
                <div style="flex:1 1 320px;display:flex;flex-direction:column;gap:12px">
                    <div style="background:#FFFFFF;border:1px solid #DCE5EE;border-radius:12px;padding:16px 20px">
                        <div style="font-size:15px;font-weight:700;margin-bottom:8px">Where it came from</div>
                        <t t-foreach="origin" t-as="o">
                            <div style="display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid #EAF0F6;font-size:13px">
                                <span style="color:#5B6776"><t t-out="o['k']"/></span>
                                <span style="font-weight:600;text-align:right"><t t-out="o['v']"/></span>
                            </div>
                        </t>
                    </div>
                    <div style="background:#FFFFFF;border:1px solid #DCE5EE;border-radius:12px;padding:16px 20px">
                        <div style="font-size:15px;font-weight:700;margin-bottom:8px">Packing</div>
                        <t t-foreach="packing" t-as="p">
                            <div style="display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid #EAF0F6;font-size:13px">
                                <span style="color:#5B6776"><t t-out="p['k']"/></span>
                                <span t-attf-style="font-weight:600;text-align:right;color:#{p['c']}"><t t-out="p['v']"/></span>
                            </div>
                        </t>
                    </div>
                    <div style="background:#FFFFFF;border:1px solid #DCE5EE;border-radius:12px;padding:16px 20px">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                            <div style="font-size:15px;font-weight:700">Delivery details</div>
                            <span t-attf-style="background:#{delivery_badge['bg']};color:#{delivery_badge['fg']};border-radius:999px;padding:4px 10px;font-size:11px;font-weight:600"><t t-out="delivery_badge['label']"/></span>
                        </div>
                        <t t-foreach="delivery" t-as="d">
                            <div style="display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid #EAF0F6;font-size:13px">
                                <span style="color:#5B6776"><t t-out="d['k']"/></span>
                                <span t-attf-style="font-weight:600;text-align:right;color:#{d['c']}"><t t-out="d['v']"/></span>
                            </div>
                        </t>
                    </div>
                </div>
                <div style="flex:1 1 360px;background:#FFFFFF;border:1px solid #DCE5EE;border-radius:12px;padding:16px 22px">
                    <div style="font-size:15px;font-weight:700;margin-bottom:12px">Full history</div>
                    <t t-foreach="events" t-as="e">
                        <div style="display:flex;gap:12px">
                            <div style="display:flex;flex-direction:column;align-items:center">
                                <div t-attf-style="width:12px;height:12px;border-radius:50%;background:#{e['color']};margin-top:4px"></div>
                                <div style="width:2px;flex-grow:1;background:#E1E9F1;margin-top:2px"></div>
                            </div>
                            <div style="padding-bottom:12px;flex-grow:1">
                                <div style="display:flex;justify-content:space-between;gap:10px">
                                    <span style="font-size:13px;font-weight:600"><t t-out="e['title']"/></span>
                                    <span style="font-size:11px;color:#5B6776;white-space:nowrap"><t t-out="e['when']"/></span>
                                </div>
                                <div style="font-size:12px;color:#5B6776;margin-top:1px"><t t-out="e['note']"/></div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </template>

    <!-- PDF version -->
    <record id="action_report_advmfg_journey" model="ir.actions.report">
        <field name="name">Serial Journey (live)</field>
        <field name="model">advmfg.serial.journey</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advance_manufacturing.report_advmfg_journey</field>
        <field name="report_file">advance_manufacturing.report_advmfg_journey</field>
        <field name="paperformat_id" ref="paperformat_advmfg_a4"/>
        <field name="print_report_name">'Serial_Journey_%s' % object.serial_no</field>
    </record>
    <!-- The PDF: two A4 pages built from tables (the PDF engine breaks flex boxes). Page 1 = summary, progress, origin, packing. Page 2 = delivery details, full history. -->
    <template id="report_advmfg_journey">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="vals" t-value="o._journey_values()"/>
                <t t-set="company" t-value="o.unit_id.company_id"/>
                <t t-set="th" t-value="'background:#6D4AA8;color:#FFFFFF;font-size:11px;font-weight:bold;letter-spacing:.6px;text-transform:uppercase;padding:8px 14px;text-align:left;'"/>
                <t t-set="tk" t-value="'padding:7px 14px;border-top:1px solid #EFE9F8;font-size:11px;color:#5B6776;width:42%;'"/>
                <t t-set="tv" t-value="'padding:7px 14px;border-top:1px solid #EFE9F8;font-size:11px;font-weight:bold;text-align:right;'"/>

                <!-- ===== page 1 ===== -->
                <div class="page" style="font-family:Arial,Helvetica,sans-serif;color:#1F2A37;">
                    <table style="width:100%;border-collapse:collapse;border-bottom:3px solid #6D4AA8;">
                        <tr>
                            <td style="width:56px;padding:0 0 10px 0;vertical-align:middle;">
                                <div style="width:42px;height:42px;border-radius:10px;background:#6D4AA8;color:#FFFFFF;font-size:17px;font-weight:bold;text-align:center;line-height:42px;"><t t-esc="(company.name or 'M')[:2].upper()"/></div>
                            </td>
                            <td style="padding:0 0 10px 0;vertical-align:middle;">
                                <div style="font-size:15px;font-weight:bold;"><t t-esc="company.name"/></div>
                                <div style="font-size:11px;color:#5B6776;">Serial Journey Report</div>
                            </td>
                            <td style="padding:0 0 10px 0;text-align:right;vertical-align:middle;font-size:11px;color:#5B6776;">Printed <t t-esc="vals['now']"/><br/>Page 1 of 2</td>
                        </tr>
                    </table>

                    <table style="width:100%;border-collapse:collapse;margin-top:18px;">
                        <tr>
                            <td style="vertical-align:bottom;">
                                <div style="font-size:10px;font-weight:bold;color:#5B6776;letter-spacing:1px;text-transform:uppercase;">Serial number</div>
                                <div style="font-size:34px;font-weight:bold;line-height:1.15;"><t t-esc="vals['serial']"/></div>
                                <div style="font-size:12px;color:#5B6776;margin-top:2px;"><t t-esc="vals['product']"/></div>
                            </td>
                            <td style="vertical-align:bottom;text-align:right;">
                                <t t-foreach="vals['chips']" t-as="c">
                                    <span t-attf-style="background:#{c['bg']};color:#{c['fg']};border-radius:12px;padding:4px 12px;font-size:11px;font-weight:bold;margin-left:4px;"><t t-esc="c['label']"/></span>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <table style="width:100%;border-collapse:separate;border-spacing:8px;margin:12px 0 0 -8px;table-layout:fixed;">
                        <tr>
                            <t t-foreach="vals['facts']" t-as="f">
                                <td style="background:#F4EFFB;border-radius:8px;padding:9px 12px;vertical-align:top;">
                                    <div style="font-size:9px;font-weight:bold;color:#5B6776;text-transform:uppercase;"><t t-esc="f['k']"/></div>
                                    <div style="font-size:13px;font-weight:bold;margin-top:2px;"><t t-esc="f['v']"/></div>
                                    <div style="font-size:10px;color:#5B6776;margin-top:1px;"><t t-esc="f['s']"/></div>
                                </td>
                            </t>
                        </tr>
                    </table>

                    <table style="width:100%;border-collapse:collapse;border:1px solid #E3DAF2;margin-top:12px;page-break-inside:avoid;">
                        <tr><td t-att-colspan="len(vals['stages'])" style="padding:12px 16px 4px 16px;font-size:13px;font-weight:bold;">Manufacturing progress</td></tr>
                        <tr>
                            <t t-foreach="vals['stages']" t-as="s">
                                <td style="text-align:center;vertical-align:top;padding:8px 4px 14px 4px;">
                                    <div t-attf-style="width:28px;height:28px;border-radius:14px;background:#{s['dot']};color:#FFFFFF;font-size:13px;font-weight:bold;line-height:28px;text-align:center;margin:0 auto;"><t t-esc="s['mark']"/></div>
                                    <div style="font-size:11px;font-weight:bold;margin-top:5px;"><t t-esc="s['name']"/></div>
                                    <div style="font-size:9px;color:#5B6776;margin-top:2px;"><t t-esc="s['when']"/></div>
                                    <div style="margin-top:3px;"><span t-attf-style="font-size:9px;font-weight:bold;color:#{s['qc_fg']};background:#{s['qc_bg']};border-radius:10px;padding:2px 8px;"><t t-esc="s['qc']"/></span></div>
                                </td>
                            </t>
                        </tr>
                    </table>

                    <table style="width:100%;border-collapse:collapse;margin-top:14px;table-layout:fixed;">
                        <tr>
                            <td style="vertical-align:top;padding-right:8px;">
                                <table style="width:100%;border-collapse:collapse;border:1px solid #E3DAF2;page-break-inside:avoid;">
                                    <tr><td colspan="2" t-att-style="th">Where it came from</td></tr>
                                    <t t-foreach="vals['origin']" t-as="r"><tr><td t-att-style="tk"><t t-esc="r['k']"/></td><td t-att-style="tv"><t t-esc="r['v']"/></td></tr></t>
                                </table>
                            </td>
                            <td style="vertical-align:top;padding-left:8px;">
                                <table style="width:100%;border-collapse:collapse;border:1px solid #E3DAF2;page-break-inside:avoid;">
                                    <tr><td colspan="2" t-att-style="th">Packing</td></tr>
                                    <t t-foreach="vals['packing']" t-as="r"><tr><td t-att-style="tk"><t t-esc="r['k']"/></td><td t-att-style="tv + 'color:' + r['c'] + ';'"><t t-esc="r['v']"/></td></tr></t>
                                </table>
                            </td>
                        </tr>
                    </table>
                    <div style="font-size:10px;color:#9AA8B7;text-align:center;margin-top:16px;">Delivery details and full history continue on page 2 - System generated document - <t t-esc="company.name"/></div>
                </div>

                <!-- ===== page 2 ===== -->
                <div class="page" style="page-break-before:always;font-family:Arial,Helvetica,sans-serif;color:#1F2A37;">
                    <table style="width:100%;border-collapse:collapse;border-bottom:3px solid #6D4AA8;">
                        <tr>
                            <td style="width:56px;padding:0 0 10px 0;vertical-align:middle;">
                                <div style="width:42px;height:42px;border-radius:10px;background:#6D4AA8;color:#FFFFFF;font-size:17px;font-weight:bold;text-align:center;line-height:42px;"><t t-esc="(company.name or 'M')[:2].upper()"/></div>
                            </td>
                            <td style="padding:0 0 10px 0;vertical-align:middle;">
                                <div style="font-size:15px;font-weight:bold;"><t t-esc="company.name"/></div>
                                <div style="font-size:11px;color:#5B6776;">Serial Journey Report - <t t-esc="vals['serial']"/></div>
                            </td>
                            <td style="padding:0 0 10px 0;text-align:right;vertical-align:middle;font-size:11px;color:#5B6776;">Printed <t t-esc="vals['now']"/><br/>Page 2 of 2</td>
                        </tr>
                    </table>

                    <table style="width:100%;border-collapse:collapse;border:1px solid #E3DAF2;margin-top:18px;page-break-inside:avoid;">
                        <tr>
                            <td colspan="2" t-att-style="th">Delivery details</td>
                            <td t-att-style="th + 'text-align:right;'"><span t-attf-style="background:#{vals['delivery_badge']['bg']};color:#{vals['delivery_badge']['fg']};border-radius:10px;padding:2px 9px;font-size:10px;text-transform:none;"><t t-esc="vals['delivery_badge']['label']"/></span></td>
                        </tr>
                        <t t-foreach="vals['delivery']" t-as="r">
                            <tr style="page-break-inside:avoid;">
                                <td t-att-style="tk" colspan="1"><t t-esc="r['k']"/></td>
                                <td t-att-style="tv + 'color:' + r['c'] + ';text-align:left;'" colspan="2"><t t-esc="r['v']"/></td>
                            </tr>
                        </t>
                    </table>

                    <table style="width:100%;border-collapse:collapse;border:1px solid #E3DAF2;margin-top:14px;">
                        <tr><td colspan="3" t-att-style="th">Full history</td></tr>
                        <t t-foreach="vals['events']" t-as="e">
                            <tr style="page-break-inside:avoid;">
                                <td style="width:22px;padding:9px 0 9px 14px;vertical-align:top;border-top:1px solid #EFE9F8;">
                                    <div t-attf-style="width:10px;height:10px;border-radius:5px;background:#{e['color']};margin-top:3px;"></div>
                                </td>
                                <td style="padding:8px 8px;border-top:1px solid #EFE9F8;vertical-align:top;">
                                    <div style="font-size:12px;font-weight:bold;"><t t-esc="e['title']"/></div>
                                    <div style="font-size:10px;color:#5B6776;margin-top:1px;"><t t-esc="e['note']"/></div>
                                </td>
                                <td style="padding:8px 14px 8px 0;border-top:1px solid #EFE9F8;vertical-align:top;text-align:right;font-size:10px;color:#5B6776;white-space:nowrap;"><t t-esc="e['when']"/></td>
                            </tr>
                        </t>
                    </table>
                    <div style="font-size:10px;color:#9AA8B7;text-align:center;margin-top:16px;">Live data, read fresh when printed - System generated document - <t t-esc="company.name"/></div>
                </div>
            </t>
        </t>
    </template>
</odoo>
