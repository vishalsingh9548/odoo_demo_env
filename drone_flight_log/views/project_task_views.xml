<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_drone_flight" model="ir.ui.view">
        <field name="name">project.task.form.drone.flight</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_log_drone_flight" type="object" string="Log Flight"
                        class="btn-primary" groups="drone_sales_crm.group_drone_user" invisible="not is_span"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="d-md-none rounded-2 bg-info-subtle p-2 mb-3" name="drone_mobile_panel"
                     groups="drone_sales_crm.group_drone_user" invisible="not is_span">
                    <div class="fw-bold">
                        <i class="fa fa-arrows-h me-1" title="Span"/>
                        <field name="tower_from" readonly="1" class="d-inline"/> → <field name="tower_to" readonly="1" class="d-inline"/>
                    </div>
                    <div class="small">
                        <field name="span_length_m" readonly="1" class="d-inline"/> m ·
                        <field name="crossing_type" readonly="1" class="d-inline"/> ·
                        <field name="drone_flight_count" readonly="1" class="d-inline"/> flights
                    </div>
                    <div class="d-flex flex-column gap-2 mt-2" name="drone_mobile_buttons">
                        <button name="action_log_drone_flight" type="object" string="Log Flight" icon="fa-plane"
                                class="btn btn-primary btn-lg w-100"/>
                        <button name="action_view_drone_flights" type="object" string="Flights on this Span" icon="fa-list"
                                class="btn btn-secondary w-100"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_drone_flights" type="object" class="oe_stat_button"
                        icon="fa-paper-plane" groups="drone_sales_crm.group_drone_user" invisible="not is_span">
                    <field name="drone_flight_count" widget="statinfo" string="Flights"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='drone_span_details']//group[field[@name='span_length_m']]" position="inside">
                <field name="drone_flight_minutes" groups="drone_sales_crm.group_drone_user"/>
            </xpath>
            <!-- Log flights straight from the span task -->
            <xpath expr="//page[@name='drone_span_details']" position="after">
                <page string="Flight Log" name="drone_flight_log" groups="drone_sales_crm.group_drone_user"
                      invisible="not is_span">
                    <field name="drone_flight_ids" mode="list,kanban"
                           context="{'default_task_id': id}">
                        <list editable="bottom" default_order="takeoff_time desc"
                              decoration-muted="state == 'cancel'"
                              decoration-info="state == 'draft'"
                              decoration-danger="state == 'done' and result == 'aborted'">
                            <field name="name" readonly="1" optional="show"/>
                            <field name="drone_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="battery_ids" widget="many2many_tags" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="pilot_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="takeoff_time" readonly="state != 'draft'"/>
                            <field name="landing_time" readonly="state != 'draft'"/>
                            <field name="duration_min" sum="Total (min)"/>
                            <field name="result" readonly="state != 'draft'"/>
                            <field name="abort_reason" optional="show" readonly="state != 'draft'"
                                   invisible="result == 'success'"/>
                            <field name="wind_kmh" optional="hide" readonly="state != 'draft'"/>
                            <field name="weather" optional="hide" readonly="state != 'draft'"/>
                            <field name="state" widget="badge" readonly="1"
                                   decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
                            <field name="company_id" column_invisible="1"/>
                            <button name="action_landed_now" type="object" string="Landed" icon="fa-flag-checkered"
                                    invisible="state != 'draft' or landing_time"/>
                            <button name="action_done" type="object" string="Confirm" icon="fa-check"
                                    class="text-success" invisible="state != 'draft' or not landing_time"/>
                            <button name="action_report_breakdown" type="object" string="Breakdown"
                                    icon="fa-exclamation-triangle" class="text-danger" invisible="state == 'cancel'"/>
                        </list>
                        <kanban class="o_kanban_mobile">
                            <field name="state"/>
                            <field name="result"/>
                            <field name="landing_time"/>
                            <templates>
                                <t t-name="card">
                                    <div class="d-flex justify-content-between">
                                        <field name="name" class="fw-bold"/>
                                        <span t-if="record.state.raw_value == 'draft'" class="badge rounded-pill text-bg-info">
                                            <t t-if="record.landing_time.raw_value">Landed</t><t t-else="">In progress</t>
                                        </span>
                                        <span t-elif="record.state.raw_value == 'done'"
                                              t-attf-class="badge rounded-pill text-bg-#{record.result.raw_value == 'success' and 'success' or record.result.raw_value == 'retry' and 'warning' or 'danger'}"><field name="result"/></span>
                                        <span t-else="" class="badge rounded-pill text-bg-secondary">Cancelled</span>
                                    </div>
                                    <div class="small"><i class="fa fa-paper-plane me-1" title="Drone"/><field name="drone_id"/></div>
                                    <field name="battery_ids" widget="many2many_tags"/>
                                    <div class="small text-muted"><field name="takeoff_time"/> · <field name="duration_min"/> min</div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
