<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drone_breakdown_wizard_view_form" model="ir.ui.view">
        <field name="name">drone.breakdown.wizard.form</field>
        <field name="model">drone.breakdown.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Equipment Breakdown">
                <field name="flight_equipment_ids" invisible="1"/>
                <field name="flight_state" invisible="1"/>
                <group>
                    <group>
                        <field name="flight_id"/>
                        <field name="equipment_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="Drone and/or batteries that broke"/>
                        <field name="breakdown_type"/>
                    </group>
                    <group>
                        <field name="request_replacement"/>
                        <field name="site_location" invisible="not request_replacement"
                               required="request_replacement"/>
                        <field name="required_date" invisible="not request_replacement"
                               required="request_replacement"/>
                        <field name="abort_flight" invisible="flight_state != 'draft'"/>
                    </group>
                </group>
                <field name="description" placeholder="What happened? e.g. motor 3 stopped at 40 m, emergency landing near T-110"/>
                <footer>
                    <button name="action_confirm" type="object" string="Report Breakdown" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
