<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Home Kouzina users get the custom mo_status_bar below instead of the standard statusbar;
                 everyone else keeps the standard one. -->
            <xpath expr="//form/header/field[@name='state']" position="attributes">
                <attribute name="groups">!hk_access.group_hk_access</attribute>
            </xpath>
            <xpath expr="//form/header" position="inside">
                <t groups="hk_access.group_hk_access">
                    <field name="show_auto_assign_finished_lot" invisible="1"/>
                    <field name="is_manufacture_approver" invisible="1"/>
                    <field name="approval_status" invisible="1"/>
                    <field name="mo_status_bar"
                           widget="statusbar"
                           statusbar_visible="draft,pending,approved,confirmed,done"/>
                    <button name="action_auto_assign_finished_lot"
                            type="object"
                            string="Assign Finished Lot"
                            class="btn-secondary"
                            invisible="not show_auto_assign_finished_lot"/>


                    <button name="action_approved_submit"
                            type="object"
                            string="Submit for Approval"
                            class="btn-primary"
                            invisible="state != 'draft' or approval_status not in (False, 'draft')"
                            />


                    <button name="action_approved"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            invisible="not is_manufacture_approver or approval_status != 'pending'"
                            />

                </t>
            </xpath>

            <!-- Renamed both date_start labels (the core view shows a different one
                 depending on state) to "Production Date" so it always reads the
                 same regardless of the MO's stage, instead of switching between
                 "Scheduled Date" and "Start Date". Odoo's view inheritance won't
                 allow selecting by the "string" attribute, so they're targeted by
                 position instead (1st = "Scheduled Date" label, 2nd = "Start Date"
                 label, per the core view's order). -->
            <xpath expr="(//label[@for='date_start'])[1]" position="attributes">
                <attribute name="string">Production Date</attribute>
            </xpath>
            <xpath expr="(//label[@for='date_start'])[2]" position="attributes">
                <attribute name="string">Production Date</attribute>
            </xpath>

            <!-- New read-only field showing when this MO was first submitted for
                 approval (set automatically in action_approved_submit, not
                 user-editable), placed right after the existing Scheduled End
                 field so it sits with the other date info. The core view has
                 TWO field[@name='date_finished'] nodes: an invisible technical
                 one near the top of the sheet (used for onchange tracking) and
                 the real, visible "Scheduled End" field further down in the
                 date group. The first attempt used an unindexed xpath and
                 silently matched the wrong (invisible) one, so requested_date
                 never actually appeared on screen even though the field itself
                 worked correctly. Indexed to [2] to hit the visible one. -->
            <xpath expr="(//field[@name='date_finished'])[2]" position="after">
                <t groups="hk_access.group_hk_access">
                    <field name="requested_date"/>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
