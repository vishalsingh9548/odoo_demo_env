<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_margin_report_search" model="ir.ui.view">
        <field name="name">sale.margin.report.search</field>
        <field name="model">sale.margin.report</field>
        <field name="arch" type="xml">
            <search string="Margin Report">
                <field name="so_name" string="Sales Order"/>
                <field name="customer_name" string="Customer"/>
                <field name="city" string="City"/>
                <field name="marketplace_type" string="Marketplace"/>
                <field name="product_name" string="Product"/>
                <field name="sku" string="SKU"/>
                <field name="invoice_number" string="Invoice Number"/>
                <separator/>
                <filter string="Blinkit" name="mp_blinkit"
                    domain="[('marketplace_type', 'in', ['blinkit', 'Blinkit'])]"/>
                <filter string="Flipkart" name="mp_flipkart"
                    domain="[('marketplace_type', 'in', ['flipkart', 'Flipkart'])]"/>
                <filter string="Instamart" name="mp_instamart"
                    domain="[('marketplace_type', 'in', ['instamart', 'Instamart'])]"/>
                <filter string="Meesho" name="mp_meesho"
                    domain="[('marketplace_type', 'in', ['meesho', 'Meesho'])]"/>
                <filter string="Myntra" name="mp_myntra"
                    domain="[('marketplace_type', 'in', ['myntra', 'Myntra'])]"/>
                <filter string="Zepto" name="mp_zepto"
                    domain="[('marketplace_type', 'in', ['zepto', 'Zepto'])]"/>
                <filter string="Amazon" name="mp_amazon"
                    domain="[('marketplace_type', 'in', ['amazon', 'Amazon'])]"/>
                <filter string="Shopify" name="mp_shopify"
                    domain="[('marketplace_type', 'in', ['shopify', 'Shopify'])]"/>
                <filter name="finished_only" string="Finished Goods"
                    domain="[('is_finished_good', '=', True)]"/>
                <filter name="retail_only" string="Retail Goods"
                    domain="[('is_retail', '=', True)]"/>

                <separator/>
                <filter name="filter_today" string="Today"
                    domain="[('order_date', '=', context_today())]"/>

                <filter name="filter_this_month" string="This Month"
                    domain="[('order_date', '&gt;=', (context_today() + relativedelta(day=1)))]"/>

                <group expand="0" string="Group By">
                    <filter name="group_marketplace" string="Marketplace" context="{'group_by': 'marketplace_type'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_name'}"/>
                    <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_name'}"/>
                    <filter name="group_is_finished_good" string="Is Finished Good" context="{'group_by': 'is_finished_good'}"/>
                    <filter name="group_is_retail" string="Is Retail" context="{'group_by': 'is_retail'}"/>
                    <filter name="group_order_date" string="Order Date" context="{'group_by': 'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sale_margin_report_list" model="ir.ui.view">
        <field name="name">sale.margin.report.list</field>
        <field name="model">sale.margin.report</field>
        <field name="arch" type="xml">
            <list string="Sales Margin Report" create="false" edit="false" delete="false">
                <field name="so_name" string="Sales Order Number"/>
                <field name="customer_name" string="Customer Name"/>
                <field name="city" string="City" optional="hide"/>
                <field name="marketplace_type" string="Marketplace" optional="show"/>
                <field name="invoice_number" string="Invoice Number" optional="hide"/>
                <field name="product_name" string="Product Name"/>
                <field name="ean_number" string="EAN Number" optional="hide"/>
                <field name="sku" string="SKU" optional="hide"/>
                <field name="is_retail" string="Is Retail"/>
                <field name="product_uom_qty" string="Qty"/>
                <field name="cogs" string="COGS" widget="monetary"/>
                <field name="nett" string="Gross Sale" widget="monetary"/>
                <field name="mrp" string="Product Sale" widget="monetary"/>
                <field name="gross_acv" string="Gross ACV" widget="monetary"/>
                <field name="product_acv" string="Product ACV" widget="monetary"/>
                <!-- MR-change 4: percentage widget shows the '%' sign -->
                <field name="cogs_percent" string="COGS %" widget="percentage"/>
                <!-- MR-change 5: percentage widget shows the '%' sign -->
                <field name="gross_margin" string="Gross Margin %" widget="percentage"/>
                <!-- MR-change 7: Discount / Discount % moved to after Gross Margin % -->
                <field name="discount" string="Discount" widget="monetary"/>
                <!-- MR-change 6: percentage widget shows the '%' sign -->
                <field name="discount_percent" string="Discount %" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="action_sale_margin_report" model="ir.actions.act_window">
        <field name="name">Margin Report</field>
        <field name="res_model">sale.margin.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sale_margin_report_list"/>
        <field name="search_view_id" ref="view_sale_margin_report_search"/>
        <field name="context">{'visible_group_export': True}</field>
    </record>
</odoo>
