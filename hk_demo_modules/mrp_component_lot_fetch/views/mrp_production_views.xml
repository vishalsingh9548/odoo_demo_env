<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_fetch_component_lots" model="ir.ui.view">
        <field name="name">mrp.production.form.fetch.component.lots</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <t groups="hk_access.group_hk_access">
                    <field name="show_fetch_component_lots" invisible="1"/>
                    <button name="action_fetch_component_lots"
                            type="object"
                            string="Assign Component Lots"
                            class="btn-secondary"
                            invisible="not show_fetch_component_lots"/>
                </t>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']//list/field[@name='location_id']" position="before">
                <field groups="hk_access.group_hk_access" name="component_available_location_ids" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']//list/field[@name='location_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="domain">[('id', 'in', component_available_location_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
