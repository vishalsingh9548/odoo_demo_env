<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="view_solar_registration_list" model="ir.ui.view">
        <field name="name">solar.registration.list</field>
        <field name="model">solar.registration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="sales_rep_id"/>
                <field name="payment_mode"/>
                <field name="state"/>
                <field name="payment_clearance_state"/>
            </list>
        </field>
    </record>

    <record id="view_solar_registration_form" model="ir.ui.view">
        <field name="name">solar.registration.form</field>
        <field name="model">solar.registration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_process" string="Start Process" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>

                    <button name="action_select_cash_payment" string="Client Selects Full Cash" type="object"
                            class="btn-primary" invisible="state != 'file_checked'"/>
                    <button name="action_select_loan_payment" string="Client Selects Loan" type="object"
                            invisible="state != 'file_checked'"/>
                    <button name="action_select_partial_loan_payment" string="Client Selects Partial Loan" type="object"
                            invisible="state != 'file_checked'"/>

                    <button name="action_feasibility_approve" string="Feasibility: Approve" type="object"
                            class="btn-primary" invisible="state != 'cash_feasibility_check'"/>
                    <button name="action_feasibility_reject" string="Feasibility: Reject" type="object"
                            invisible="state != 'cash_feasibility_check'"/>

                    <button name="action_loan_approve" string="Loan: Approve" type="object"
                            class="btn-primary" invisible="state != 'loan_process'"/>
                    <button name="action_loan_reject" string="Loan: Reject" type="object"
                            invisible="state != 'loan_process'"/>

                    <button name="action_create_installation" string="Create Installation" type="object"
                            class="btn-primary" invisible="state != 'approved'"/>

                    <button name="action_approve_payment_clearance" string="Approve Payment Clearance" type="object"
                            class="btn-primary"
                            invisible="not installation_files_received or payment_clearance_state == 'approved'"/>

                    <button name="action_create_discom_activation" string="Submit to DISCOM" type="object"
                            class="btn-primary" invisible="payment_clearance_state != 'approved'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,file_checked,cash_feasibility_check,loan_process,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_installations" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="installation_count" widget="statinfo" string="Installations"/>
                        </button>
                        <button name="action_view_discom" type="object" class="oe_stat_button"
                                icon="fa-bolt" invisible="not discom_id">
                            <field name="discom_count" widget="statinfo" string="DISCOM"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Deal">
                            <field name="sale_order_id"/>
                            <field name="design_id"/>
                            <field name="lead_id"/>
                            <field name="sales_rep_id"/>
                        </group>
                        <group string="Payment Mode">
                            <field name="payment_mode" readonly="1"/>
                            <field name="cash_feasibility_result" invisible="payment_mode != 'cash'"/>
                            <field name="loan_dept_user_id" invisible="payment_mode not in ('loan', 'partial_loan')"/>
                            <field name="loan_approval_result" invisible="payment_mode not in ('loan', 'partial_loan')"/>
                        </group>
                    </group>

                    <group string="Stage 9-10: Installation Files &amp; Payment Clearance">
                        <group>
                            <field name="installation_files_received" readonly="1"/>
                            <field name="installation_files_received_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="payment_clearance_state" readonly="1"/>
                            <field name="payment_clearance_checked_by_id"/>
                            <field name="payment_clearance_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    </data>
</odoo>
