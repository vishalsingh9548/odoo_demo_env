<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="crm_lead_form_solar" model="ir.ui.view">
        <field name="name">crm.lead.form.solar</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="after">
                <field name="customer_type" groups="grando_solar.group_solar_user"/>
                <field name="solar_capacity" groups="grando_solar.group_solar_user"/>
                <field name="monthly_bill" groups="grando_solar.group_solar_user"/>
                <field name="roof_type" groups="grando_solar.group_solar_user"/>
            </xpath>

            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="after">
                <field name="customer_type" groups="grando_solar.group_solar_user"/>
                <field name="solar_capacity" groups="grando_solar.group_solar_user"/>
                <field name="monthly_bill" groups="grando_solar.group_solar_user"/>
                <field name="roof_type" groups="grando_solar.group_solar_user"/>
            </xpath>

        </field>
    </record>

    </data>
</odoo>
