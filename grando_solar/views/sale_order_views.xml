<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="sale_order_form_solar" model="ir.ui.view">
        <field name="name">sale.order.form.solar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <field name="quotation_stage" widget="statusbar"
                       statusbar_visible="quotation_provided,token_payment,payment_mode_confirmed,documents_collected,shared_with_registration"
                       groups="grando_solar.group_solar_user"/>
                <button name="action_quotation_approve" string="Approve Quotation" type="object"
                        class="btn-primary" invisible="quotation_stage != 'quotation_provided'"
                        groups="grando_solar.group_solar_user"/>
                <button name="action_quotation_reject" string="Reject Quotation" type="object"
                        invisible="quotation_stage != 'quotation_provided'"
                        groups="grando_solar.group_solar_user"/>
                <button name="action_collect_token_payment" string="Collect Token Payment" type="object"
                        class="btn-primary" invisible="quotation_stage != 'token_payment'"
                        groups="grando_solar.group_solar_user"/>
                <button name="action_confirm_payment_mode" string="Confirm Payment Mode" type="object"
                        class="btn-primary" invisible="quotation_stage != 'payment_mode_confirmed'"
                        groups="grando_solar.group_solar_user"/>
                <button name="action_collect_client_documents" string="Collect Client Documents" type="object"
                        class="btn-primary" invisible="quotation_stage != 'payment_mode_confirmed'"
                        groups="grando_solar.group_solar_user"/>
                <button name="action_share_with_registration" string="Share Deal with Registration Dept" type="object"
                        class="btn-primary" invisible="quotation_stage != 'documents_collected'"
                        groups="grando_solar.group_solar_user"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_registration" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" invisible="not registration_id"
                        groups="grando_solar.group_solar_user">
                    <field name="registration_count" widget="statinfo" string="Registration"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Solar Deal" name="solar_deal" groups="grando_solar.group_solar_user">
                    <group>
                        <group string="Quotation Process">
                            <field name="token_payment_amount"/>
                            <field name="token_payment_date"/>
                            <field name="payment_type"/>
                            <field name="client_documents_collected"/>
                        </group>
                        <group string="Terms">
                            <field name="warranty_type"/>
                            <field name="delivery_type"/>
                            <field name="freight_type"/>
                            <field name="cancellation_policy"/>
                            <field name="certifications_type"/>
                            <field name="tolerance_type"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>



    <record id="view_order_form_inherit_state_visible" model="ir.ui.view">
        <field name="name">sale.order.form.state.visible</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Case 1: state field already exists but is invisible somewhere -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>


        </field>
    </record>

    </data>
</odoo>
