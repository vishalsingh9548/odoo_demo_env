<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_discom_view_list" model="ir.ui.view">
            <field name="name">epc.discom.list</field>
            <field name="model">epc.discom</field>
            <field name="arch" type="xml">
                <list string="DISCOMs" editable="bottom">
                    <field name="name"/>
                    <field name="state_id"/>
                    <field name="portal_url" widget="url"/>
                </list>
            </field>
        </record>
        <record id="epc_discom_action" model="ir.actions.act_window">
            <field name="name">DISCOMs</field>
            <field name="res_model">epc.discom</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add your first electricity board (DISCOM)</p>
                <p>These appear in a drop-down on the lead and are reused on government forms.</p>
            </field>
        </record>
    </data>
</odoo>
