<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_dealer_view_list" model="ir.ui.view">
            <field name="name">epc.dealer.list</field>
            <field name="model">epc.dealer</field>
            <field name="arch" type="xml">
                <list string="Dealers">
                    <field name="complete_name"/>
                    <field name="parent_id" optional="hide"/>
                    <field name="phone"/>
                    <field name="commission_percent"/>
                    <field name="lead_count"/>
                </list>
            </field>
        </record>
        <record id="epc_dealer_view_form" model="ir.ui.view">
            <field name="name">epc.dealer.form</field>
            <field name="model">epc.dealer</field>
            <field name="arch" type="xml">
                <form string="Dealer">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_leads" type="object" class="oe_stat_button" icon="fa-handshake-o">
                                <field name="lead_count" widget="statinfo" string="Leads"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="parent_id"/>
                                <field name="commission_percent"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Sub-dealers" name="children" invisible="parent_id">
                                <field name="child_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="phone"/>
                                        <field name="commission_percent"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="epc_dealer_action" model="ir.actions.act_window">
            <field name="name">Dealers</field>
            <field name="res_model">epc.dealer</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add your first dealer</p>
                <p>Dealers and sub-dealers can be chosen on a lead to track who brought it.</p>
            </field>
        </record>
    </data>
</odoo>
