<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="project_view_form_epc_dealer" model="ir.ui.view">
            <field name="name">project.view.form.epc.dealer</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="csl_epc_core.project_view_form_epc"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='epc_solar']" position="inside">
                    <field name="discom_id"/>
                    <field name="consumer_number"/>
                    <field name="dealer_id"/>
                    <field name="sub_dealer_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
