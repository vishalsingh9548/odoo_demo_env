<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_lead_view_form_epc_dealer" model="ir.ui.view">
            <field name="name">crm.lead.form.epc.dealer</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="csl_epc_core.crm_lead_view_form_epc"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='epc_solar_details']/group" position="after">
                    <group>
                        <group string="Electricity Connection (DISCOM)" name="epc_discom" groups="csl_epc_core.group_epc_admin">
                            <field name="discom_id"/>
                            <field name="consumer_number"/>
                            <field name="connection_type"/>
                        </group>
                        <group string="Dealer" name="epc_dealer" groups="csl_epc_core.group_epc_admin">
                            <field name="dealer_id"/>
                            <field name="sub_dealer_id" invisible="not dealer_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
