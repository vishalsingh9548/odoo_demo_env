<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Where material goes once it's actually installed and no longer
             warehouse stock — moving stock here (instead of just deleting a
             number) is what makes the reduction a real, auditable stock move -->
        <record id="epc_location_consumed" model="stock.location">
            <field name="name">Installed / Consumed Material</field>
            <field name="usage">inventory</field>
            <field name="location_id" ref="stock.stock_location_locations_virtual"/>
        </record>
    </data>
</odoo>
