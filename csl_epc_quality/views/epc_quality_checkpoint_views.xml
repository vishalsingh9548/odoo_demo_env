<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_quality_checkpoint_view_list" model="ir.ui.view">
            <field name="name">epc.quality.checkpoint.list</field>
            <field name="model">epc.quality.checkpoint</field>
            <field name="arch" type="xml">
                <list string="QC Checkpoints" editable="bottom" default_order="category, sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="category"/>
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="epc_quality_checkpoint_action" model="ir.actions.act_window">
            <field name="name">QC Checkpoints</field>
            <field name="res_model">epc.quality.checkpoint</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_category': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add your first QC Checkpoint</p>
                <p>
                    These are the checklist items suggested automatically when someone
                    picks a QC Category on a new Quality Check. Add, rename, reorder or
                    untick Active to switch one off — no code change needed.
                </p>
            </field>
        </record>
    </data>
</odoo>
