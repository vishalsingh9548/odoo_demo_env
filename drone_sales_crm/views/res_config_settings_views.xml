<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_drone" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.drone</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="drone_quote_terms" string="Drone Terms" company_dependent="1"
                         groups="drone_sales_crm.group_drone_user"
                         help="Printed in a 'Drone terms' section at the end of the quotation / order PDF.">
                    <field name="drone_quote_terms" placeholder="e.g. Pilot rope supplied by..., crossing permissions arranged by the client..."/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
