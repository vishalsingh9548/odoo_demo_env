<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_drone" model="ir.ui.view">
        <field name="name">product.template.form.drone</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="is_stringing_km" invisible="type != 'service'" groups="drone_sales_crm.group_drone_user"/>
            </xpath>
        </field>
    </record>
</odoo>
