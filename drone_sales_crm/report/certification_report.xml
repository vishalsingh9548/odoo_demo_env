<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_drone_certification" model="ir.actions.report">
        <field name="name">Client Certification</field>
        <field name="model">drone.certification</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">drone_sales_crm.report_drone_certification</field>
        <field name="report_file">drone_sales_crm.report_drone_certification</field>
        <field name="print_report_name">'Certification - %s' % (object.name).replace('/', '-')</field>
        <field name="binding_model_id" ref="model_drone_certification"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_drone_certification_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="order" t-value="doc.sale_order_id"/>
            <t t-set="vals" t-value="doc._drone_report_values()"/>
            <t t-set="address">
                <div t-field="doc.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <p t-if="doc.partner_id.vat">
                    <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                       t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
                </p>
            </t>
            <div class="page">
                <div class="oe_structure"/>
                <t t-set="layout_document_title">
                    <span>Client Certification # </span>
                    <span t-field="doc.name">CERT/2026/0001</span>
                    <span t-if="doc.state == 'draft'" class="text-muted"> (Draft)</span>
                </t>

                <div class="row mb-4" id="informations">
                    <div class="col" name="info_date">
                        <strong>Certification Date</strong>
                        <div t-field="doc.date"/>
                    </div>
                    <div t-if="order.client_order_ref" class="col" name="info_client_po">
                        <strong>Client PO</strong>
                        <div t-field="order.client_order_ref"/>
                    </div>
                    <div class="col" name="info_order">
                        <strong>Our Order</strong>
                        <div t-field="order.name"/>
                    </div>
                    <div t-if="doc.client_engineer" class="col" name="info_engineer">
                        <strong>Client Engineer</strong>
                        <div t-field="doc.client_engineer"/>
                    </div>
                </div>

                <div class="row mb-4" name="stringing_job">
                    <div t-if="order.line_name" class="col" name="job_line">
                        <strong>Line</strong>
                        <div t-field="order.line_name"/>
                    </div>
                    <div t-if="order.voltage_kv" class="col-2" name="job_voltage">
                        <strong>Voltage</strong>
                        <div><span t-field="order.voltage_kv"/> kV</div>
                    </div>
                    <div t-if="order.site_location" class="col" name="job_site">
                        <strong>Site / route</strong>
                        <div t-field="order.site_location"/>
                    </div>
                </div>

                <table class="table table-sm o_main_table mt-2" name="km_summary">
                    <thead>
                        <tr>
                            <th class="text-start">Description</th>
                            <th class="text-end">Length (km)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Ordered</td>
                            <td class="text-end" t-out="vals['ordered_km']" t-options='{"widget": "float", "precision": 3}'/>
                        </tr>
                        <tr>
                            <td>Certified before this certificate</td>
                            <td class="text-end" t-out="vals['previous_km']" t-options='{"widget": "float", "precision": 3}'/>
                        </tr>
                        <tr class="fw-bold">
                            <td>Certified by this certificate</td>
                            <td class="text-end" t-out="doc.certified_km" t-options='{"widget": "float", "precision": 3}'/>
                        </tr>
                        <tr>
                            <td>Cumulative certified to date</td>
                            <td class="text-end" t-out="vals['cumulative_km']" t-options='{"widget": "float", "precision": 3}'/>
                        </tr>
                        <tr>
                            <td>Balance to certify</td>
                            <td class="text-end" t-out="vals['balance_km']" t-options='{"widget": "float", "precision": 3}'/>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end mb-4" name="value_of_work" t-if="vals['rate']">
                    <div class="col-6">
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td>Rate per km (as per order)</td>
                                <td class="text-end">
                                    <span t-out="vals['rate']" t-options='{"widget": "monetary", "display_currency": vals["currency"]}'/>
                                </td>
                            </tr>
                            <tr class="border-top fw-bold">
                                <td>Value of work certified (before tax)</td>
                                <td class="text-end">
                                    <span t-out="vals['amount']" t-options='{"widget": "monetary", "display_currency": vals["currency"]}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="doc.note" class="mb-4" name="remarks">
                    <strong>Remarks</strong>
                    <div t-field="doc.note"/>
                </div>
                <p t-if="doc.invoice_id" class="text-muted" name="invoice_ref">
                    Invoiced on <span t-field="doc.invoice_id.name"/>.
                </p>

                <p class="mt-3 mb-0" name="declaration">
                    We certify that the length shown above as "Certified by this certificate" has been
                    strung with pilot rope by drone and accepted on site.
                </p>

                <div class="row mt-4" name="signatures" style="page-break-inside: avoid;">
                    <div class="col-6">
                        <div style="height: 1.6cm;"/>
                        <div class="border-top pt-1">
                            <strong>Certified by the client</strong><br/>
                            <span t-if="doc.client_engineer" t-field="doc.client_engineer"/>
                            <span t-else="">Name and designation</span><br/>
                            <span t-field="doc.partner_id.name"/> · Signature, date and stamp
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="height: 1.6cm;"/>
                        <div class="border-top pt-1">
                            <strong>For <span t-field="doc.company_id.name"/></strong><br/>
                            Site Supervisor / Project Manager<br/>
                            Signature and date
                        </div>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_drone_certification">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="drone_sales_crm.report_drone_certification_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
