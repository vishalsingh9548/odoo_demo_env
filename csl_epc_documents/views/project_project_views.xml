<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="project_view_form_epc_documents" model="ir.ui.view">
            <field name="name">project.view.form.epc.documents</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="csl_epc_core.project_view_form_epc"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-files-o"
                            groups="csl_epc_core.group_epc_admin" invisible="epc_document_count == 0">
                        <field name="epc_document_progress" widget="percentpie" string="Documents"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
