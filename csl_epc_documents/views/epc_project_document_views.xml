<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_project_document_view_list" model="ir.ui.view">
            <field name="name">epc.project.document.list</field>
            <field name="model">epc.project.document</field>
            <field name="arch" type="xml">
                <list string="Project Documents" decoration-danger="is_overdue">
                    <field name="project_id"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="mandatory" optional="show"/>
                    <field name="due_date"/>
                    <field name="is_overdue" column_invisible="1"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'"
                           decoration-info="state == 'submitted'" decoration-warning="state == 'ready'"/>
                </list>
            </field>
        </record>
        <record id="epc_project_document_view_form" model="ir.ui.view">
            <field name="name">epc.project.document.form</field>
            <field name="model">epc.project.document</field>
            <field name="arch" type="xml">
                <form string="Project Document">
                    <header>
                        <button name="action_mark_ready" string="Mark Ready" type="object" class="oe_highlight"
                                invisible="state not in ('pending', 'rejected')"/>
                        <button name="action_submit" string="Mark Submitted" type="object" class="oe_highlight"
                                invisible="state not in ('ready',)"/>
                        <button name="action_accept" string="Accepted" type="object" invisible="state != 'submitted'"/>
                        <button name="action_reject" string="Rejected" type="object" invisible="state != 'submitted'"/>
                        <button name="action_print_form" string="Print Auto-filled Form" type="object"/>
                        <button name="action_reset" string="Reset" type="object" invisible="state == 'pending'"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,ready,submitted,accepted"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name"/></h1></div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="partner_id"/>
                                <field name="category"/>
                                <field name="mandatory"/>
                            </group>
                            <group>
                                <field name="due_date"/>
                                <field name="submitted_date"/>
                                <field name="scan" filename="scan_filename"/>
                                <field name="scan_filename" invisible="1"/>
                            </group>
                        </group>
                        <group><field name="remarks"/></group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="epc_project_document_view_search" model="ir.ui.view">
            <field name="name">epc.project.document.search</field>
            <field name="model">epc.project.document</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="project_id"/>
                    <filter name="pending" string="Not Yet Submitted" domain="[('state', 'in', ('pending', 'ready', 'rejected'))]"/>
                    <filter name="overdue" string="Overdue" domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'in', ('pending', 'ready', 'rejected'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="g_project" string="Project" context="{'group_by': 'project_id'}"/>
                        <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="g_category" string="Category" context="{'group_by': 'category'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="epc_project_document_action" model="ir.actions.act_window">
            <field name="name">Project Documents</field>
            <field name="res_model">epc.project.document</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
        </record>
    </data>
</odoo>
