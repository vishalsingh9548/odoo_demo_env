<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Live dashboard of this stage, rendered by the generic screen in csl_epc_core.
             It is the first menu entry, so the app opens on it. -->
        <record id="epc_dashboard_handover_action" model="ir.actions.client">
            <field name="name">Handover Dashboard</field>
            <field name="tag">epc_stage_dashboard</field>
            <field name="target">current</field>
            <field name="params" eval="{'stage': 'handover'}"/>
        </record>
        <menuitem id="menu_epc_dashboard_handover"
                  name="Dashboard"
                  parent="menu_epc_handover"
                  action="epc_dashboard_handover_action"
                  sequence="1"/>
    </data>
</odoo>
