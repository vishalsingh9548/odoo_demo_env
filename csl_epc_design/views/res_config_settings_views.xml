<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_epc_design" model="ir.ui.view">
            <field name="name">res.config.settings.form.epc.design</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="csl_epc_core.res_config_settings_view_form_epc"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='epc_approvals_block']" position="after">
                    <block title="System Design" name="epc_design_block">
                        <setting string="Require Approved Design Before BOQ"
                                 help="A BOQ can only be created once the feasibility study has an approved System Design.">
                            <field name="epc_require_design"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
