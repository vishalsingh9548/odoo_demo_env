<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_commissioning_view_list" model="ir.ui.view">
            <field name="name">epc.commissioning.list</field>
            <field name="model">epc.commissioning</field>
            <field name="arch" type="xml">
                <list string="Commissioning">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="partner_id"/>
                    <field name="commissioning_date"/>
                    <field name="customer_approved"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'submitted'"/>
                </list>
            </field>
        </record>

        <record id="epc_commissioning_view_form" model="ir.ui.view">
            <field name="name">epc.commissioning.form</field>
            <field name="model">epc.commissioning</field>
            <field name="arch" type="xml">
                <form string="Commissioning">
                    <header>
                        <button name="action_submit" string="Submit for Approval" type="object"
                                class="oe_highlight"
                                invisible="approval_state != 'to_submit' or epc_needs_final_qc"/>
                        <button name="action_consume_site_stock" string="Consume Site Stock" type="object"
                                invisible="approval_state != 'to_submit' or epc_needs_final_qc or not epc_can_consume_site_stock"/>
                        <button name="action_log_quality_check" string="Log Quality Check" type="object"
                                class="oe_highlight"
                                invisible="approval_state != 'to_submit' or not epc_needs_final_qc"/>
                        <button name="action_approve" string="Approve" type="object"
                                class="oe_highlight" groups="csl_solar_epc.group_epc_manager"
                                invisible="approval_state != 'submitted'"/>
                        <button name="action_reject" string="Reject" type="object"
                                groups="csl_solar_epc.group_epc_manager"
                                invisible="approval_state != 'submitted'"/>
                        <button name="action_reset_to_submit" string="Reset to Draft" type="object"
                                invisible="approval_state not in ('submitted', 'rejected')"/>
                        <button name="%(epc_commissioning_report_action)d" string="Print Certificate" type="action"
                                invisible="approval_state != 'approved'"/>
                        <button name="action_create_handover" string="Proceed to Handover" type="object"
                                class="oe_highlight" invisible="not epc_needs_handover"/>
                        <field name="approval_state" widget="statusbar"
                               statusbar_visible="to_submit,submitted,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="partner_id"/>
                                <field name="commissioning_date"/>
                            </group>
                            <group>
                                <field name="system_testing_done"/>
                                <field name="generation_verification_kwh"/>
                                <field name="customer_walkthrough_done"/>
                                <field name="customer_approved"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Checklist" name="checklist">
                                <field name="commissioning_checklist"/>
                            </page>
                            <page string="Certificate" name="certificate">
                                <field name="commissioning_certificate" filename="commissioning_certificate_filename"/>
                                <field name="commissioning_certificate_filename" invisible="1"/>
                            </page>
                            <page string="Approval" name="approval">
                                <group>
                                    <field name="submitted_by" readonly="1"/>
                                    <field name="submitted_date" readonly="1"/>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                    <field name="rejection_reason"
                                           invisible="approval_state not in ('submitted', 'rejected')"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="epc_commissioning_action" model="ir.actions.act_window">
            <field name="name">Commissioning</field>
            <field name="res_model">epc.commissioning</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first Commissioning record</p>
                <p>The formal switch-on and sign-off point before Handover.</p>
            </field>
        </record>
    </data>
</odoo>
