<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_quality_check_view_list" model="ir.ui.view">
            <field name="name">epc.quality.check.list</field>
            <field name="model">epc.quality.check</field>
            <field name="arch" type="xml">
                <list string="Quality Checks">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="category"/>
                    <field name="inspector_id"/>
                    <field name="check_date"/>
                    <field name="overall_result" widget="badge"
                           decoration-success="overall_result == 'pass'"
                           decoration-danger="overall_result == 'fail'"
                           decoration-muted="overall_result == 'pending'"/>
                </list>
            </field>
        </record>

        <record id="epc_quality_check_view_form" model="ir.ui.view">
            <field name="name">epc.quality.check.form</field>
            <field name="model">epc.quality.check</field>
            <field name="arch" type="xml">
                <form string="Quality Check">
                    <header>
                        <button name="action_consume_site_stock" string="Consume Site Stock" type="object"
                                class="oe_highlight"
                                invisible="category != 'final' or overall_result != 'pass'"/>
                        <field name="overall_result" widget="statusbar" statusbar_visible="pending,pass,fail"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="category"/>
                                <field name="picking_id" invisible="category != 'incoming_material'"
                                       domain="[('project_id', '=', project_id), ('picking_type_id.code', '=', 'incoming')]"/>
                            </group>
                            <group>
                                <field name="inspector_id"/>
                                <field name="check_date"/>
                            </group>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="result"/>
                                <field name="remarks"/>
                            </list>
                        </field>
                        <group>
                            <field name="remarks"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="epc_quality_check_action" model="ir.actions.act_window">
            <field name="name">Quality Checks</field>
            <field name="res_model">epc.quality.check</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first Quality Check</p>
                <p>Covers all four QC categories: Incoming Material, Installation, Electrical and Final.</p>
            </field>
        </record>
    </data>
</odoo>
