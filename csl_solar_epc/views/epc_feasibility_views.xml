<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_feasibility_view_list" model="ir.ui.view">
            <field name="name">epc.feasibility.list</field>
            <field name="model">epc.feasibility</field>
            <field name="arch" type="xml">
                <list string="Feasibility Studies">
                    <field name="name"/>
                    <field name="lead_id"/>
                    <field name="partner_id"/>
                    <field name="proposed_capacity_kw"/>
                    <field name="system_type"/>
                    <field name="feasibility_result"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'submitted'"/>
                </list>
            </field>
        </record>

        <record id="epc_feasibility_view_form" model="ir.ui.view">
            <field name="name">epc.feasibility.form</field>
            <field name="model">epc.feasibility</field>
            <field name="arch" type="xml">
                <form string="Technical Feasibility">
                    <header>
                        <button name="action_submit" string="Submit for Approval" type="object"
                                class="oe_highlight" invisible="approval_state != 'to_submit'"/>
                        <button name="action_approve" string="Approve" type="object"
                                class="oe_highlight" groups="csl_solar_epc.group_epc_manager"
                                invisible="approval_state != 'submitted'"/>
                        <button name="action_reject" string="Reject" type="object"
                                groups="csl_solar_epc.group_epc_manager"
                                invisible="approval_state != 'submitted'"/>
                        <button name="action_reset_to_submit" string="Reset to Draft" type="object"
                                invisible="approval_state not in ('submitted', 'rejected')"/>
                        <button name="action_create_boq" string="Create BOQ" type="object"
                                class="oe_highlight" invisible="approval_state != 'approved' or boq_count &gt; 0"/>
                        <field name="approval_state" widget="statusbar"
                               statusbar_visible="to_submit,submitted,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_boq" type="object"
                                    class="oe_stat_button" icon="fa-calculator"
                                    invisible="boq_count == 0">
                                <field name="boq_count" widget="statinfo" string="BOQs"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Reference">
                                <field name="site_survey_id"/>
                                <field name="lead_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group string="System Design">
                                <field name="proposed_capacity_kw"/>
                                <field name="system_type"/>
                                <field name="module_tilt_angle"/>
                                <field name="module_orientation"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Layout &amp; Generation" name="layout">
                                <group>
                                    <field name="plant_layout" filename="plant_layout_filename"/>
                                    <field name="plant_layout_filename" invisible="1"/>
                                    <field name="annual_generation_estimate_kwh"/>
                                    <field name="performance_ratio"/>
                                </group>
                            </page>
                            <page string="Financials" name="financials">
                                <field name="financial_benefits"/>
                            </page>
                            <page string="Report &amp; Result" name="report">
                                <field name="feasibility_report"/>
                                <field name="feasibility_result"/>
                            </page>
                            <page string="Approval" name="approval">
                                <group>
                                    <field name="submitted_by" readonly="1"/>
                                    <field name="submitted_date" readonly="1"/>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                    <field name="rejection_reason"
                                           invisible="approval_state not in ('submitted', 'rejected')"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="epc_feasibility_action" model="ir.actions.act_window">
            <field name="name">Feasibility Studies</field>
            <field name="res_model">epc.feasibility</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Feasibility Study
                </p>
                <p>
                    A Feasibility Study turns Site Survey measurements into a concrete
                    system design (size, layout, expected generation) before costing.
                </p>
            </field>
        </record>
    </data>
</odoo>
