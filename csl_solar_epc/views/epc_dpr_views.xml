<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_dpr_view_list" model="ir.ui.view">
            <field name="name">epc.dpr.list</field>
            <field name="model">epc.dpr</field>
            <field name="arch" type="xml">
                <list string="Daily Progress Reports">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="report_date"/>
                    <field name="reported_by"/>
                    <field name="weather"/>
                    <field name="manpower_deployed"/>
                </list>
            </field>
        </record>

        <record id="epc_dpr_view_form" model="ir.ui.view">
            <field name="name">epc.dpr.form</field>
            <field name="model">epc.dpr</field>
            <field name="arch" type="xml">
                <form string="Daily Progress Report">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="report_date"/>
                                <field name="reported_by"/>
                            </group>
                            <group>
                                <field name="weather"/>
                                <field name="manpower_deployed"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Progress" name="progress">
                                <field name="work_progress_summary"/>
                            </page>
                            <page string="Material &amp; Equipment" name="material">
                                <group>
                                    <field name="material_received"/>
                                    <field name="material_consumed"/>
                                    <field name="equipment_deployed"/>
                                </group>
                            </page>
                            <page string="Photo" name="photo">
                                <field name="site_photo" widget="image"/>
                                <field name="site_photo_filename" invisible="1"/>
                            </page>
                            <page string="Issues &amp; Tomorrow's Plan" name="issues">
                                <group>
                                    <field name="issues_risks"/>
                                    <field name="tomorrow_plan"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="epc_dpr_action" model="ir.actions.act_window">
            <field name="name">Daily Progress Reports</field>
            <field name="res_model">epc.dpr</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first Daily Progress Report</p>
                <p>One short diary entry per project per day, so the office always knows what happened on site.</p>
            </field>
        </record>
    </data>
</odoo>
