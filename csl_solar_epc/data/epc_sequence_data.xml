<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Gives every Site Survey a reference like SS/2026/00001 -->
        <record id="seq_epc_site_survey" model="ir.sequence">
            <field name="name">Site Survey Sequence</field>
            <field name="code">epc.site.survey</field>
            <field name="prefix">SS/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

