<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_epc_boq_user" model="ir.rule">
            <field name="name">BOQ: field users see their own</field>
            <field name="model_id" ref="model_epc_boq"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_user'))]"/>
        </record>
        <record id="rule_epc_boq_manager" model="ir.rule">
            <field name="name">BOQ: managers see all</field>
            <field name="model_id" ref="model_epc_boq"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_manager'))]"/>
        </record>
        <record id="rule_epc_boq_line_user" model="ir.rule">
            <field name="name">BOQ line: field users see their own</field>
            <field name="model_id" ref="model_epc_boq_line"/>
            <field name="domain_force">[('boq_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_user'))]"/>
        </record>
        <record id="rule_epc_boq_line_manager" model="ir.rule">
            <field name="name">BOQ line: managers see all</field>
            <field name="model_id" ref="model_epc_boq_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_manager'))]"/>
        </record>
    </data>
</odoo>
