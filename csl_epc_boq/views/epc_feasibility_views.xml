<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_feasibility_view_form_boq" model="ir.ui.view">
            <field name="name">epc.feasibility.form.boq</field>
            <field name="model">epc.feasibility</field>
            <field name="inherit_id" ref="csl_epc_feasibility.epc_feasibility_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='approval_state']" position="before">
                        <button name="action_create_boq" string="Create BOQ" type="object"
                                class="oe_highlight" invisible="approval_state != 'approved' or boq_count &gt; 0"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                            <button name="action_view_boq" type="object"
                                    class="oe_stat_button" icon="fa-calculator"
                                    invisible="boq_count == 0">
                                <field name="boq_count" widget="statinfo" string="BOQs"/>
                            </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
