<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Live dashboard of this stage, rendered by the generic screen in csl_epc_core.
             It is the first menu entry, so the app opens on it. -->
        <record id="epc_dashboard_boq_action" model="ir.actions.client">
            <field name="name">BOQ Dashboard</field>
            <field name="tag">epc_stage_dashboard</field>
            <field name="target">current</field>
            <field name="params" eval="{'stage': 'boq'}"/>
        </record>
        <menuitem id="menu_epc_dashboard_boq"
                  name="Dashboard"
                  parent="menu_epc_boq"
                  action="epc_dashboard_boq_action"
                  sequence="1"/>

        <!-- Drill-down lists opened from the dashboard -->
        <record id="epc_boq_line_view_list" model="ir.ui.view">
            <field name="name">epc.boq.line.list</field>
            <field name="model">epc.boq.line</field>
            <field name="arch" type="xml">
                <list create="0" delete="0">
                    <field name="boq_id"/>
                    <field name="category"/>
                    <field name="product_id" optional="show"/>
                    <field name="description"/>
                    <field name="quantity"/>
                    <field name="uom_id" optional="show"/>
                    <field name="unit_cost"/>
                    <field name="subtotal" sum="Total"/>
                </list>
            </field>
        </record>
        <record id="epc_boq_line_view_form" model="ir.ui.view">
            <field name="name">epc.boq.line.form</field>
            <field name="model">epc.boq.line</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="boq_id"/>
                                <field name="category"/>
                                <field name="product_id"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="unit_cost"/>
                                <field name="subtotal"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="epc_boq_line_view_search" model="ir.ui.view">
            <field name="name">epc.boq.line.search</field>
            <field name="model">epc.boq.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="boq_id"/>
                    <field name="product_id"/>
                    <field name="description"/>
                    <group expand="0" string="Group By">
                        <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                        <filter name="group_boq" string="BOQ" context="{'group_by': 'boq_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
