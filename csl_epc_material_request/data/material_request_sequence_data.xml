<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Gives every Material Request a reference like MR/2026/00001 -->
        <record id="seq_epc_material_request" model="ir.sequence">
            <field name="name">Material Request Sequence</field>
            <field name="code">epc.material.request</field>
            <field name="prefix">MR/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
