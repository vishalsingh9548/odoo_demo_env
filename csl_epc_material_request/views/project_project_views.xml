<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="project_view_form_epc_mr" model="ir.ui.view">
            <field name="name">project.view.form.epc.mr</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="csl_epc_core.project_view_form_epc"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_open_share_project_wizard']" position="after">
                    <button name="action_create_material_request" string="New Material Request" type="object"
                            class="oe_highlight" invisible="not boq_id or material_request_count != 0"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_material_requests" type="object"
                            class="oe_stat_button" icon="fa-truck"
                            invisible="material_request_count == 0">
                        <field name="material_request_count" widget="statinfo" string="Material Requests"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
