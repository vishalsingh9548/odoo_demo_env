<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_epc_material_request_user" model="ir.rule">
            <field name="name">Material Request: field users see their own</field>
            <field name="model_id" ref="model_epc_material_request"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('requested_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_user'))]"/>
        </record>
        <record id="rule_epc_material_request_manager" model="ir.rule">
            <field name="name">Material Request: managers see all</field>
            <field name="model_id" ref="model_epc_material_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_manager'))]"/>
        </record>
        <record id="rule_epc_material_request_line_user" model="ir.rule">
            <field name="name">Material Request line: field users see their own</field>
            <field name="model_id" ref="model_epc_material_request_line"/>
            <field name="domain_force">['|', ('request_id.create_uid', '=', user.id), ('request_id.requested_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_user'))]"/>
        </record>
        <record id="rule_epc_material_request_line_manager" model="ir.rule">
            <field name="name">Material Request line: managers see all</field>
            <field name="model_id" ref="model_epc_material_request_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('csl_epc_core.group_epc_manager'))]"/>
        </record>
    </data>
</odoo>
