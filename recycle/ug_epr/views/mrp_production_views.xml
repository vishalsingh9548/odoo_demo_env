<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_ug_epr" model="ir.ui.view">
        <field name="name">mrp.production.form.ug.epr</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="ug_recycling_base.mrp_production_form_view_ug"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ug_create_epr_certificate" type="object" string="Create EPR Certificate"
                    groups="ug_recycling_base.group_ug_epr"
                    invisible="state != 'done' or not ug_is_recycling or ug_epr_available_kg &lt;= 0"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_ug_view_epr_certificates" type="object" class="oe_stat_button" icon="fa-check-circle"
                    invisible="not ug_epr_certificate_count">
                    <field name="ug_epr_certificate_count" widget="statinfo" string="EPR"/>
                </button>
            </div>
            <page name="ug_mass_balance" position="after">
                <page string="EPR" name="ug_epr" invisible="not ug_is_recycling or state != 'done'">
                    <group>
                        <group>
                            <field name="ug_epr_eligible_kg"/>
                            <field name="ug_epr_claimed_kg"/>
                            <field name="ug_epr_available_kg"/>
                        </group>
                        <group>
                            <field name="ug_epr_certificate_ids" widget="many2many_tags"/>
                            <div colspan="2" class="text-muted" invisible="ug_epr_eligible_kg">
                                EPR quantity comes from the stage set in Settings › Manufacturing › EPR Basis
                                (battery weight processed → dismantle orders; recovered material → recover orders).
                            </div>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="mrp_production_view_list_ug_chain_epr" model="ir.ui.view">
        <field name="name">mrp.production.list.ug.chain.epr</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="ug_recycling_base.mrp_production_view_list_ug_chain"/>
        <field name="arch" type="xml">
            <field name="ug_loss_pct" position="after">
                <field name="ug_epr_eligible_kg" string="EPR Eligible (kg)" optional="show"/>
                <field name="ug_epr_available_kg" string="EPR Available (kg)" optional="show"/>
            </field>
        </field>
    </record>

    <record id="mrp_production_view_pivot_ug_epr" model="ir.ui.view">
        <field name="name">mrp.production.pivot.ug.epr</field>
        <field name="model">mrp.production</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="EPR Eligible vs Claimed">
                <field name="ug_stage" type="row"/>
                <field name="battery_chemistry_id" type="row"/>
                <field name="date_finished" interval="month" type="col"/>
                <field name="ug_epr_eligible_kg" type="measure"/>
                <field name="ug_epr_claimed_kg" type="measure"/>
                <field name="ug_epr_available_kg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ug_epr_production_action" model="ir.actions.act_window">
        <field name="name">EPR Eligible vs Claimed</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'pivot', 'view_id': ref('mrp_production_view_pivot_ug_epr')})]"/>
        <field name="domain">[('ug_is_recycling', '=', True), ('state', '=', 'done')]</field>
    </record>
</odoo>
