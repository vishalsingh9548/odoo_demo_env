<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ug_epr" model="ir.ui.view">
        <field name="name">res.config.settings.form.ug.epr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <t groups="ug_recycling_base.group_ug_user">
                    <block title="EPR (Battery Waste Management Rules)" name="ug_epr_setting_container">
                        <setting id="ug_epr_basis" company_dependent="1"
                            help="Quantity on which EPR certificates are generated (confirm with the CPCB rules)">
                            <field name="ug_epr_basis" widget="radio"/>
                        </setting>
                        <setting id="ug_epr_product" company_dependent="1"
                            help="Service product used on EPR certificate quotations and invoices">
                            <field name="ug_epr_product_id"/>
                        </setting>
                    </block>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
