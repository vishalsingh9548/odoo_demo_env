<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ug_epr_category_view_list" model="ir.ui.view">
        <field name="name">ug.epr.category.list</field>
        <field name="model">ug.epr.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ug_epr_category_action" model="ir.actions.act_window">
        <field name="name">EPR Categories</field>
        <field name="res_model">ug.epr.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
