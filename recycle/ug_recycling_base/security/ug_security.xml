<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_recycling" model="ir.module.category">
        <field name="name">Recycling</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_ug_user" model="res.groups">
        <field name="name">Recycling Access</field>
        <field name="category_id" ref="module_category_recycling"/>
        <field name="comment">Single switch for the whole Recycling app: menus, fields, tabs, buttons and configuration.</field>
        <field name="implied_ids" eval="[
            (4, ref('mrp.group_mrp_manager')),
            (4, ref('mrp.group_mrp_byproducts')),
            (4, ref('mrp.group_mrp_routings')),
            (4, ref('stock.group_production_lot')),
            (4, ref('quality.group_quality_user')),
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
