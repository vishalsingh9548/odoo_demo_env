<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_recycling" model="ir.module.category">
        <field name="name">Recycling</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_ug_user" model="res.groups">
        <field name="name">Recycling User</field>
        <field name="category_id" ref="module_category_recycling"/>
        <field name="implied_ids" eval="[
            (4, ref('mrp.group_mrp_user')),
            (4, ref('mrp.group_mrp_byproducts')),
            (4, ref('mrp.group_mrp_routings')),
            (4, ref('stock.group_production_lot')),
            (4, ref('quality.group_quality_user')),
        ]"/>
    </record>

    <record id="group_ug_lab" model="res.groups">
        <field name="name">Lab Technician</field>
        <field name="category_id" ref="module_category_recycling"/>
        <field name="implied_ids" eval="[(4, ref('group_ug_user'))]"/>
    </record>

    <record id="group_ug_epr" model="res.groups">
        <field name="name">EPR Officer</field>
        <field name="category_id" ref="module_category_recycling"/>
        <field name="implied_ids" eval="[(4, ref('group_ug_user'))]"/>
    </record>

    <record id="group_ug_manager" model="res.groups">
        <field name="name">Recycling Manager</field>
        <field name="category_id" ref="module_category_recycling"/>
        <field name="implied_ids" eval="[(4, ref('group_ug_lab')), (4, ref('group_ug_epr')), (4, ref('mrp.group_mrp_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
