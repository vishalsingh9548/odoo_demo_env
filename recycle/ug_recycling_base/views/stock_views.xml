<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quant_search_view_ug" model="ir.ui.view">
        <field name="name">stock.quant.search.ug.recycling</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="battery_chemistry_id"/>
                <separator/>
                <filter name="ug_scrap_battery" string="Scrap Batteries" domain="[('ug_material_type', '=', 'scrap_battery')]"/>
                <filter name="ug_intermediate" string="Intermediates" domain="[('ug_material_type', '=', 'intermediate')]"/>
                <filter name="ug_recovered" string="Recovered Materials" domain="[('ug_material_type', '=', 'recovered_material')]"/>
                <filter name="ug_scrap_byproduct" string="Scrap By-products" domain="[('ug_material_type', '=', 'scrap_byproduct')]"/>
                <filter name="ug_chemical" string="Chemicals" domain="[('ug_material_type', '=', 'chemical')]"/>
                <separator/>
                <filter name="groupby_ug_material_type" string="Material Type" context="{'group_by': 'ug_material_type'}"/>
                <filter name="groupby_battery_chemistry" string="Battery Chemistry" context="{'group_by': 'battery_chemistry_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_form_ug" model="ir.ui.view">
        <field name="name">stock.lot.form.ug.recycling</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="battery_chemistry_id" invisible="not battery_chemistry_id"/>
                <field name="ug_material_type" invisible="not ug_material_type"/>
            </field>
        </field>
    </record>

    <record id="search_product_lot_filter_ug" model="ir.ui.view">
        <field name="name">stock.lot.search.ug.recycling</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="battery_chemistry_id"/>
                <filter name="groupby_ug_material_type" string="Material Type" context="{'group_by': 'ug_material_type'}"/>
                <filter name="groupby_battery_chemistry" string="Battery Chemistry" context="{'group_by': 'battery_chemistry_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
