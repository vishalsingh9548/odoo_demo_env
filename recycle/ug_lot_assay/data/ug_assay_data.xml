<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ug_lot_assay" model="ir.sequence">
            <field name="name">Lot Assay</field>
            <field name="code">ug.lot.assay</field>
            <field name="prefix">ASSAY/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="element_li" model="ug.assay.element"><field name="name">Lithium</field><field name="code">Li</field><field name="sequence">10</field></record>
        <record id="element_ni" model="ug.assay.element"><field name="name">Nickel</field><field name="code">Ni</field><field name="sequence">20</field></record>
        <record id="element_co" model="ug.assay.element"><field name="name">Cobalt</field><field name="code">Co</field><field name="sequence">30</field></record>
        <record id="element_mn" model="ug.assay.element"><field name="name">Manganese</field><field name="code">Mn</field><field name="sequence">40</field></record>
        <record id="element_fe" model="ug.assay.element"><field name="name">Iron</field><field name="code">Fe</field><field name="sequence">50</field></record>
        <record id="element_p" model="ug.assay.element"><field name="name">Phosphorus</field><field name="code">P</field><field name="sequence">60</field></record>
        <record id="element_al" model="ug.assay.element"><field name="name">Aluminium</field><field name="code">Al</field><field name="sequence">70</field></record>
        <record id="element_cu" model="ug.assay.element"><field name="name">Copper</field><field name="code">Cu</field><field name="sequence">80</field></record>
        <record id="element_c" model="ug.assay.element"><field name="name">Graphite</field><field name="code">C</field><field name="sequence">90</field></record>
        <record id="element_na" model="ug.assay.element"><field name="name">Sodium</field><field name="code">Na</field><field name="sequence">100</field></record>

        <record id="template_nmc_black_mass" model="ug.assay.template">
            <field name="name">NMC black mass</field>
            <field name="battery_chemistry_id" ref="ug_recycling_base.chemistry_nmc"/>
            <field name="element_ids" eval="[(6, 0, [ref('element_ni'), ref('element_co'), ref('element_mn'), ref('element_li'), ref('element_c'), ref('element_al'), ref('element_cu')])]"/>
        </record>
        <record id="template_lfp_black_mass" model="ug.assay.template">
            <field name="name">LFP black mass</field>
            <field name="battery_chemistry_id" ref="ug_recycling_base.chemistry_lfp"/>
            <field name="element_ids" eval="[(6, 0, [ref('element_li'), ref('element_fe'), ref('element_p'), ref('element_c'), ref('element_al'), ref('element_cu')])]"/>
        </record>
    </data>
</odoo>
