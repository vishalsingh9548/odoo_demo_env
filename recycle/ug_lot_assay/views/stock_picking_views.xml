<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_ug_assay" model="ir.ui.view">
        <field name="name">stock.picking.form.ug.assay</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ug_has_assay" invisible="1"/>
                <button name="action_ug_print_coa" type="object" string="Print CoA"
                    invisible="not ug_has_assay or picking_type_code != 'outgoing'"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='lot_ids']" position="after">
                <field name="ug_has_assay" column_invisible="True"/>
                <button name="action_ug_print_coa" type="object" icon="fa-certificate" title="Print CoA"
                    invisible="not ug_has_assay"/>
            </xpath>
        </field>
    </record>
</odoo>
