<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ug_process_queue_view_list" model="ir.ui.view">
        <field name="name">ug.process.queue.list</field>
        <field name="model">ug.process.queue</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="not ready" decoration-danger="ready and waiting_days &gt; 30">
                <header>
                    <button name="action_create_production" type="object" string="Create MO" class="btn-primary"/>
                </header>
                <field name="ready" column_invisible="True"/>
                <field name="stage"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="battery_chemistry_id"/>
                <field name="source_production_id" optional="show"/>
                <field name="assay_state" widget="badge" optional="show"
                    decoration-success="assay_state == 'approved'" decoration-warning="assay_state == 'pending'"
                    invisible="assay_state == 'not_required'"/>
                <field name="in_date" optional="hide"/>
                <field name="waiting_days"/>
                <field name="on_hand_kg" optional="hide" sum="Total"/>
                <field name="reserved_kg" optional="hide" sum="Total"/>
                <field name="planned_kg" optional="hide" sum="Total"/>
                <field name="available_kg" sum="Total"/>
                <field name="bom_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ug_process_queue_view_search" model="ir.ui.view">
        <field name="name">ug.process.queue.search</field>
        <field name="model">ug.process.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="battery_chemistry_id"/>
                <filter name="ready" string="Ready" domain="[('ready', '=', True)]"/>
                <filter name="waiting_lab" string="Waiting for Lab" domain="[('ready', '=', False)]"/>
                <separator/>
                <filter name="to_dismantle" string="To Dismantle" domain="[('stage', '=', 'dismantle')]"/>
                <filter name="to_shred" string="To Shred" domain="[('stage', '=', 'shred')]"/>
                <filter name="to_recover" string="To Recover" domain="[('stage', '=', 'recover')]"/>
                <separator/>
                <filter name="groupby_stage" string="Next Stage" context="{'group_by': 'stage'}"/>
                <filter name="groupby_chemistry" string="Chemistry" context="{'group_by': 'battery_chemistry_id'}"/>
                <filter name="groupby_product" string="Product" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="ug_process_queue_action" model="ir.actions.act_window">
        <field name="name">To Process</field>
        <field name="res_model">ug.process.queue</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_groupby_stage': 1, 'search_default_groupby_chemistry': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting</p>
            <p>Lots of battery packs, cells and black mass in stock that are not yet planned for their next stage appear here.
               Select lots of one product and click <b>Create MO</b>.</p>
        </field>
    </record>

    <menuitem id="menu_ug_process_queue" name="To Process" parent="ug_recycling_base.menu_ug_operations"
        action="ug_process_queue_action" sequence="5"/>
</odoo>
