<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Live dashboard of this module, drawn by the generic screen in csl_epc_core.
             It is the first menu entry, so the app opens on it. -->
        <record id="epc_dashboard_subsidy_action" model="ir.actions.client">
            <field name="name">Subsidy Dashboard</field>
            <field name="tag">epc_stage_dashboard</field>
            <field name="target">current</field>
            <field name="params" eval="{'stage': 'subsidy'}"/>
        </record>
        <menuitem id="menu_epc_dashboard_subsidy"
                  name="Dashboard"
                  parent="menu_epc_subsidy_root"
                  action="epc_dashboard_subsidy_action"
                  sequence="1"/>
    </data>
</odoo>
