<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="project_view_form_epc_subsidy" model="ir.ui.view">
            <field name="name">project.view.form.epc.subsidy</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="csl_epc_core.project_view_form_epc"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_subsidies" type="object" class="oe_stat_button" icon="fa-money"
                            groups="csl_epc_core.group_epc_admin" invisible="subsidy_count == 0">
                        <field name="subsidy_count" widget="statinfo" string="Subsidy"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
