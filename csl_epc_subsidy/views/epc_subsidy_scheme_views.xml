<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="epc_subsidy_scheme_view_list" model="ir.ui.view">
            <field name="name">epc.subsidy.scheme.list</field>
            <field name="model">epc.subsidy.scheme</field>
            <field name="arch" type="xml">
                <list string="Subsidy Schemes">
                    <field name="name"/>
                    <field name="authority"/>
                    <field name="segment"/>
                    <field name="amount_type"/>
                    <field name="amount"/>
                    <field name="max_amount"/>
                    <field name="valid_to"/>
                </list>
            </field>
        </record>
        <record id="epc_subsidy_scheme_view_form" model="ir.ui.view">
            <field name="name">epc.subsidy.scheme.form</field>
            <field name="model">epc.subsidy.scheme</field>
            <field name="arch" type="xml">
                <form string="Subsidy Scheme">
                    <sheet>
                        <div class="oe_title"><h1><field name="name" placeholder="e.g. PM Surya Ghar"/></h1></div>
                        <group>
                            <group string="Who can get it">
                                <field name="authority"/>
                                <field name="segment"/>
                                <field name="max_capacity_kw"/>
                                <field name="valid_from"/>
                                <field name="valid_to"/>
                            </group>
                            <group string="How much">
                                <field name="amount_type"/>
                                <field name="amount"/>
                                <field name="max_amount"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <group string="Papers Needed"><field name="document_template_ids" widget="many2many_tags" nolabel="1"/></group>
                        <group string="Notes"><field name="notes" nolabel="1"/></group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="epc_subsidy_scheme_action" model="ir.actions.act_window">
            <field name="name">Subsidy Schemes</field>
            <field name="res_model">epc.subsidy.scheme</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a subsidy scheme</p>
                <p>Type in the current scheme rules. They are not hard-coded because they change.</p>
            </field>
        </record>
    </data>
</odoo>
